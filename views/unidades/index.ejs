<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Gerenciar Unidades</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/unidades/create" class="btn btn-sm btn-primary">
            <i class="bi bi-building-add"></i> Nova Unidade
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cidade</th>
                <th>Endereço</th>
                <th>Telefone</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (unidades.length === 0) { %>
                <tr>
                    <td colspan="5" class="text-center">Nenhuma unidade cadastrada.</td>
                </tr>
            <% } else { %>
                <% unidades.forEach(function(unidade) { %>
                    <tr>
                        <td><strong><%= unidade.nome %></strong></td>
                        <td><%= unidade.cidade %></td>
                        <td><%= unidade.endereco %></td>
                        <td><%= unidade.telefone %></td>
                        <td class="text-end">
                            <a href="/unidades/<%= unidade.id %>/edit" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form action="/unidades/<%= unidade.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Excluir esta unidade?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>