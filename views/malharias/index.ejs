<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Gestão de Malharias</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/malharias/create" class="btn btn-sm btn-primary">
            <i class="bi bi-shop"></i> Nova Malharia
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Unidade Pertencente</th>
                <th>Capacidade Mensal</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (malharias.length === 0) { %>
                <tr>
                    <td colspan="5" class="text-center">Nenhuma malharia cadastrada.</td>
                </tr>
            <% } else { %>
                <% malharias.forEach(function(malharia) { %>
                    <tr>
                        <td><strong><%= malharia.nome %></strong></td>
                        <td><span class="badge bg-secondary"><%= malharia.tipo %></span></td>
                        <td><%= malharia.unidade ? malharia.unidade.nome : 'N/A' %></td>
                        <td><%= malharia.capacidade_mensal %></td>
                        <td class="text-end">
                            <a href="/malharias/<%= malharia.id %>/edit" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form action="/malharias/<%= malharia.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza? Isso pode afetar maquinários vinculados.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>