<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Novo Item</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/itens" class="btn btn-sm btn-secondary">Voltar</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-body">
                <% if (typeof error !== 'undefined') { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <form action="/itens" method="POST">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome do Produto/Item</label>
                        <input type="text" class="form-control" id="nome" name="nome" placeholder="Ex: Camiseta P Branca" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Salvar Item</button>
                </form>
            </div>
        </div>
    </div>
</div>