<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="/css/main.css"> 
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="icon" href="/img/logo.png" type="image/png">
</head>
<body>
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow align-items-center">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 d-flex flex-column align-items-center text-center" href="/">
            <img src="/img/logo.png" alt="Logo" style="max-height: 90px; margin-bottom: 5px;">
            <span class="fw-bold">Sistema Malharia</span>
            <span style="font-size: 0.70rem; font-weight: normal; margin-top: 3px; white-space: normal; line-height: 1.2;">SCP - UGTR - SATRE - SEAP</span>
        </a>
        
        <div class="navbar-nav w-100 d-flex flex-row justify-content-end px-4 text-light d-none d-md-flex">
            <span id="relogio-brasilia" style="font-size: 0.95rem;"></span>
        </div>

        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <%- include('../partials/navbar') %>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <%- include('../partials/alerts') %>
                
                <%- body %>
                
                <footer class="pt-3 mt-4 text-muted border-top text-center">
                    &copy; 2026 Sistema de Gestão de Malharia
                </footer>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
    
    <script>
        function atualizarRelogio() {
            const data = new Date();
            // Define o fuso horário para Brasília
            const opcoes = { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            const horaBrasilia = data.toLocaleTimeString('pt-BR', opcoes);
            
            const elementoRelogio = document.getElementById('relogio-brasilia');
            if(elementoRelogio) {
                elementoRelogio.innerHTML = '<i class="bi bi-clock me-1"></i> ' + horaBrasilia + ' (BRT)';
            }
        }
        
        // Atualiza a cada 1 segundo (1000 ms)
        setInterval(atualizarRelogio, 1000);
        atualizarRelogio(); // Executa imediatamente para não haver atraso na primeira renderização
    </script>
</body>
</html>