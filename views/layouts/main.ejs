<!DOCTYPE html>
<html lang="pt-br">
<head>
    <%- include('../partials/head') %>
    <link rel="icon" href="/img/logo.png" type="image/png">
</head>
<body>
    
    <!-- TELA DE CARREGAMENTO (OCULTA POR PADRÃO) -->
    <div id="app-loader" class="app-loader hidden">
        <div class="spinner-border text-primary" role="status" style="width: 3.5rem; height: 3.5rem;">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <div class="mt-3 fw-bold text-secondary" style="font-size: 1.1rem;">Carregando...</div>
    </div>

    <!-- Cabeçalho Fixo e Limpo -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-wrap flex-md-nowrap p-0 shadow align-items-center">
        
        <!-- LOGO RESTAURADA AO ORIGINAL PARA NÃO QUEBRAR O LAYOUT -->
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 d-flex flex-column align-items-center text-center" href="/">
            <img src="/img/logo.png" alt="Logo" style="max-height: 90px; margin-bottom: 5px;">
            <span class="fw-bold">Sistema Malharia</span>
            <span style="font-size: 0.70rem; font-weight: normal; margin-top: 3px; white-space: normal; line-height: 1.2;">SCP / UGTR / SATRE / SEAP</span>
        </a>
        
        <% 
            const envAtual = typeof currentEnv !== 'undefined' ? currentEnv : 'malharia';
            const isInsumos = (envAtual === 'insumos') || (typeof user !== 'undefined' && user && user.cargo === 'controlador'); 
        %>

        <div class="mx-auto d-none d-md-block bg-dark py-2" style="min-width: 0;">
            <%- include('../partials/topbar_ranking', { isMobile: false }) %>
        </div>

        <!-- ÁREA DIREITA DO CABEÇALHO (DESKTOP) -->
        <div class="navbar-nav d-flex flex-column justify-content-center align-items-end px-4 text-light d-none d-md-flex order-2 order-md-3" style="min-width: 260px; padding-top: 8px; padding-bottom: 8px;">
            <div class="d-flex gap-2 mb-1">
                
                <!-- BOTÃO DE INSTALAÇÃO (DESKTOP) -->
                <button class="btn btn-sm btn-info px-3 py-1 rounded-pill shadow-sm text-dark fw-bold btn-instalar-pwa align-items-center" style="display: none; font-size: 0.85rem;">
                    <i class="bi bi-download me-1"></i> Instalar Aplicativo
                </button>

                <% if (typeof user !== 'undefined' && user && user.cargo !== 'monitor' && user.cargo !== 'controlador') { %>
                    <% if (isInsumos) { %>
                        <a href="/" class="text-decoration-none text-light d-flex align-items-center px-3 py-1 rounded-pill shadow-sm" 
                           style="font-size: 0.85rem; background: linear-gradient(135deg, #0d6efd, #0dcaf0); border: 1px solid rgba(255,255,255,0.2); transition: all 0.2s ease-in-out;">
                            <i class="bi bi-shop me-2"></i> Alternar para Malharias
                        </a>
                    <% } else { %>
                        <a href="/insumos" class="text-decoration-none text-light d-flex align-items-center px-3 py-1 rounded-pill shadow-sm" 
                           style="font-size: 0.85rem; background: linear-gradient(135deg, #198754, #20c997); border: 1px solid rgba(255,255,255,0.2); transition: all 0.2s ease-in-out;">
                            <i class="bi bi-boxes me-2"></i> Alternar para Insumos
                        </a>
                    <% } %>
                <% } %>
            </div>
            <span id="relogio-brasilia" class="text-white-50 mt-1" style="font-size: 0.85rem; letter-spacing: 0.5px;"></span>
        </div>

        <!-- ÁREA DIREITA (MOBILE) - MENU E BOTÃO INSTALAR -->
        <div class="position-absolute d-md-none end-0 me-3 d-flex align-items-center gap-2" style="top: 35px;">
            <!-- BOTÃO DE INSTALAÇÃO (MOBILE) COM TEXTO -->
            <button class="btn btn-sm btn-info px-2 py-1 rounded-pill shadow-sm text-dark fw-bold btn-instalar-pwa d-flex align-items-center" style="display: none; font-size: 0.75rem;">
                <i class="bi bi-download me-1"></i> Instalar Aplicativo
            </button>
            <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
                <%- include('../partials/navbar') %>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-3">
                <div class="d-block d-md-none mb-3">
                    <%- include('../partials/topbar_ranking', { isMobile: true }) %>
                </div>

                <%- include('../partials/alerts') %>
                
                <%- body %>
                
                <footer class="pt-3 mt-4 text-muted border-top text-center">
                    &copy; 2026 Sistema de Gestão de Malharia
                </footer>
            </main>
        </div>
    </div>

    <%- include('../partials/chat') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function atualizarRelogio() {
            const data = new Date();
            const opcoes = { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            const horaBrasilia = data.toLocaleTimeString('pt-BR', opcoes);
            const elementoRelogio = document.getElementById('relogio-brasilia');
            if(elementoRelogio) elementoRelogio.innerHTML = '<i class="bi bi-clock me-1"></i> ' + horaBrasilia + ' (BRT)';
        }
        setInterval(atualizarRelogio, 1000);
        atualizarRelogio(); 
    </script>

    <!-- SCRIPT DE CARREGAMENTO INTEGRADO COM O TURBO -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const loader = document.getElementById('app-loader');
            if (loader) loader.classList.add('hidden');
        });

        document.addEventListener("turbo:visit", function() {
            const loader = document.getElementById('app-loader');
            if (loader) {
                loader.style.transition = 'none';
                loader.classList.remove('hidden');
            }
        });

        document.addEventListener("turbo:submit-start", function() {
            const loader = document.getElementById('app-loader');
            if (loader) {
                loader.style.transition = 'none';
                loader.classList.remove('hidden');
            }
        });

        document.addEventListener("turbo:load", function() {
            const loader = document.getElementById('app-loader');
            if (loader) {
                loader.style.transition = 'opacity 0.2s ease';
                loader.classList.add('hidden');
            }
        });
    </script>

    <!-- SCRIPT DO SERVICE WORKER E DO BOTÃO DE INSTALAR (PWA) -->
    <script>
        // 1. Registo do Service Worker
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('PWA: Service Worker registado.', reg.scope))
                    .catch(err => console.log('PWA: Falha ao registar.', err));
            });
        }

        // 2. Lógica para os botões "Instalar Aplicativo"
        let eventoPromptInstalacao;
        const botoesInstalar = document.querySelectorAll('.btn-instalar-pwa');

        // Escuta o evento que permite a instalação
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault(); // Impede o banner automático nativo
            eventoPromptInstalacao = e;
            // Mostra todos os botões com a classe .btn-instalar-pwa
            botoesInstalar.forEach(btn => {
                btn.style.setProperty('display', 'inline-flex', 'important');
            });
        });

        // Adiciona a ação de clique a todos os botões de instalar (desktop e mobile)
        botoesInstalar.forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!eventoPromptInstalacao) return;
                
                eventoPromptInstalacao.prompt(); // Mostra o prompt do navegador
                const { outcome } = await eventoPromptInstalacao.userChoice;
                
                eventoPromptInstalacao = null; // Limpa o evento
                
                // Esconde os botões após o utilizador responder ao prompt
                botoesInstalar.forEach(b => b.style.setProperty('display', 'none', 'important'));
            });
        });

        // Se a instalação for feita com sucesso
        window.addEventListener('appinstalled', () => {
            botoesInstalar.forEach(b => b.style.setProperty('display', 'none', 'important'));
            console.log('App instalado com sucesso.');
        });
    </script>
</body>
</html>