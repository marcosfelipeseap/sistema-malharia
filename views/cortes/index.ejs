<style>
    .folder-card { cursor: pointer; transition: all 0.2s ease-in-out; border: 2px solid transparent; }
    .folder-card:hover { transform: translateY(-5px); box-shadow: 0 .5rem 1.5rem rgba(220, 53, 69, 0.15)!important; border-color: #dc3545; background-color: #fffafb !important; }
    .produto-card-quadrado { display: flex; flex-direction: column; justify-content: center; align-items: center; transition: all 0.2s ease; border: 2px solid #e9ecef; }
    .produto-card-quadrado:hover { border-color: #dc3545; background-color: #fffafb !important; transform: scale(1.04); box-shadow: 0 .5rem 1rem rgba(220, 53, 69, 0.15)!important; }
    .produto-qtde { font-size: 2.5rem; line-height: 1; }
    .produto-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .search-box { max-width: 350px; }
    /* Bloqueio de altura da tabela para não esconder o botão Salvar */
    .table-scrollable { max-height: 45vh; overflow-y: auto; border-radius: 5px; }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="bi bi-scissors text-danger"></i> Controle de Cortes</h1>
</div>

<!-- ABAS DE NAVEGAÇÃO ATUALIZADAS -->
<ul class="nav nav-pills mb-4 shadow-sm bg-white rounded p-1 border">
    <li class="nav-item">
        <a class="nav-link active bg-danger fw-bold" href="/cortes">
            <i class="bi bi-box-arrow-in-down"></i> Entradas / Envios de Cortes
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark fw-bold" href="/cortes/consumo">
            <i class="bi bi-box-arrow-right text-primary"></i> Consumo na Costura
        </a>
    </li>
</ul>

<% if (malhariasData.length === 0) { %>
    <div class="alert alert-warning text-center shadow-sm py-4">
        <i class="bi bi-exclamation-triangle fs-1 text-warning d-block mb-2"></i>
        <h5 class="fw-bold">Nenhuma malharia vinculada</h5>
        <p class="mb-0 text-muted">Você não possui malharias atribuídas para visualizar os cortes.</p>
    </div>
<% } else { %>
    <div id="view-malharias" class="view-section">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="text-secondary m-0"><i class="bi bi-1-circle"></i> Selecione a Malharia de Destino:</h5>
            <div class="input-group search-box shadow-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar oficina..." onkeyup="pesquisarCards(this, 'lista-malharias')">
            </div>
        </div>

        <div class="row g-4" id="lista-malharias">
            <% malhariasData.forEach(function(malharia) { %>
                <div class="col-sm-6 col-md-4 col-lg-3 item-pesquisavel" data-search="<%= malharia.nome.toLowerCase() %> <%= malharia.tipo ? malharia.tipo.toLowerCase() : '' %>">
                    <div class="card h-100 shadow-sm folder-card bg-white" onclick="abrirProdutos('<%= malharia.id %>')">
                        <div class="card-body text-center d-flex flex-column justify-content-center align-items-center py-4">
                            <i class="bi bi-truck display-4 text-danger mb-3"></i>
                            <h5 class="fw-bold text-dark mb-1"><%= malharia.nome %></h5>
                            <small class="text-muted mb-2"><%= malharia.tipo || 'Setor Padrão' %></small>
                            <div class="mt-auto w-100">
                                <hr class="my-2 border-danger border-opacity-25">
                                <span class="text-danger fw-bold fs-5"><%= malharia.total_geral %> <small class="text-muted fs-6">cortes recebidos</small></span>
                                <div class="small text-muted mt-1"><%= malharia.produtos.length %> Produto(s) no Histórico</div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <% malhariasData.forEach(function(malharia) { %>
        <div id="view-produtos-<%= malharia.id %>" class="view-section d-none">
            <div class="mb-4 d-flex justify-content-between align-items-center border-bottom pb-3 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary shadow-sm" onclick="mostrarMalharias()"><i class="bi bi-arrow-left"></i> Voltar</button>
                    <h4 class="m-0 fw-bold text-dark"><i class="bi bi-shop text-danger me-1"></i> <%= malharia.nome %> <span class="text-muted fw-normal fs-5 mx-2">/</span> <span class="text-secondary"><i class="bi bi-box-seam"></i> Cortes Enviados</span></h4>
                </div>
                <div class="d-flex gap-2">
                    <% if (locals.user && user.nivel >= 3) { %>
                        <button class="btn btn-danger shadow-sm fw-bold" onclick="prepararNovoCorte('<%= malharia.id %>', '<%= malharia.nome %>')">
                            <i class="bi bi-plus-circle"></i> Lançar Cortes para Oficina
                        </button>
                    <% } %>
                    <% if (malharia.produtos.length > 0) { %>
                    <div class="input-group search-box shadow-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar produto..." onkeyup="pesquisarCards(this, 'lista-produtos-<%= malharia.id %>')">
                    </div>
                    <% } %>
                </div>
            </div>

            <% if (malharia.produtos.length === 0) { %>
                <div class="alert alert-secondary text-center py-5 border-dashed bg-light">
                    <i class="bi bi-scissors display-4 text-muted d-block mb-3 opacity-25"></i>
                    <h5 class="text-secondary">Nenhum histórico de cortes destinados a esta malharia.</h5>
                </div>
            <% } else { %>
                <div class="row g-4" id="lista-produtos-<%= malharia.id %>">
                    <% malharia.produtos.forEach(function(item) { %>
                        <div class="col-6 col-sm-4 col-md-3 col-xl-2 item-pesquisavel" data-search="<%= `${item.nome} ${item.descricao} ${item.tamanho}`.toLowerCase() %>">
                            <div class="card h-100 shadow-sm produto-card-quadrado bg-white py-3">
                                <div class="card-body d-flex flex-column text-center p-2 w-100 justify-content-between h-100">
                                    <div class="mb-2 mt-2">
                                        <h6 class="fw-bold text-primary mb-1" style="font-size: 0.95rem; line-height: 1.2;"><%= item.nome %></h6>
                                        <div class="text-muted produto-desc small" title="<%= item.descricao %>"><%= item.descricao || 'Sem descrição' %></div>
                                    </div>
                                    <div class="mt-auto pb-2 w-100">
                                        <% if(item.tamanho && item.tamanho !== '-') { %><span class="badge bg-secondary mb-1">Tam: <%= item.tamanho %></span><% } %>
                                        <div class="produto-qtde fw-bold text-danger mt-1"><%= item.total_cortado %></div>
                                        <span class="text-muted small text-uppercase fw-bold d-block mb-2" style="font-size: 0.65rem; letter-spacing: 1px;">Enviados</span>
                                        <button class="btn btn-sm btn-outline-danger w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalHistorico-<%= item.item_id %>-<%= item.tamanho ? item.tamanho.replace(/[^a-zA-Z0-9]/g, '') : 'unico' %>">
                                            <i class="bi bi-clock-history"></i> Histórico
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Histórico -->
                        <div class="modal fade" id="modalHistorico-<%= item.item_id %>-<%= item.tamanho ? item.tamanho.replace(/[^a-zA-Z0-9]/g, '') : 'unico' %>" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow">
                                    <div class="modal-header bg-light">
                                        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-clock-history text-danger"></i> Histórico de Envios</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-0 table-scrollable" style="max-height: 50vh;">
                                        <div class="bg-white p-3 border-bottom text-center position-sticky top-0 shadow-sm" style="z-index: 10;">
                                            <h6 class="mb-1 text-primary fw-bold"><%= item.nome %> <%= item.tamanho && item.tamanho !== '-' ? `(${item.tamanho})` : '' %></h6>
                                            <span class="badge bg-danger fs-6"><%= item.total_cortado %> unidades totais</span>
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <% item.historico.forEach(h => { %>
                                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                                    <div>
                                                        <span class="d-block fw-bold text-dark"><i class="bi bi-calendar-event text-muted me-1"></i> <%= new Date(h.data_corte).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></span>
                                                        <small class="text-muted">Proc: <b><%= h.numero_processo %></b> | <span class="text-danger fw-bold"><%= h.quantidade %> peças</span></small>
                                                    </div>
                                                    <div class="d-flex gap-1">
                                                        <a href="<%= h.documento_comprovante %>" target="_blank" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-pdf"></i></a>
                                                        <% if (locals.user && user.nivel >= 3) { %>
                                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="abrirModalEdicao('<%= h.id %>', '<%= h.quantidade %>', '<%= new Date(h.data_corte).toISOString().split('T')[0] %>')"><i class="bi bi-pencil"></i></button>
                                                            <form action="/cortes/<%= h.id %>/delete" method="POST" onsubmit="return confirm('Remover este registro permanentemente?');">
                                                                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-trash"></i></button>
                                                            </form>
                                                        <% } %>
                                                    </div>
                                                </li>
                                            <% }) %>
                                        </ul>
                                    </div>
                                    <div class="modal-footer bg-light">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>
    <% }); %>
<% } %>

<!-- Modal Carrinho (Lançar Novo Corte) -->
<div class="modal fade" id="modalNovoCorte" tabindex="-1" aria-hidden="true" style="z-index: 1050;">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-scissors"></i> Envio de Lote Cortado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/cortes/store" method="POST" enctype="multipart/form-data" id="formCortes" onsubmit="return validarEnvio()">
                <div class="modal-body bg-light">
                    <div class="row g-3 mb-4 p-3 bg-white border rounded shadow-sm">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-secondary"><i class="bi bi-shop"></i> Malharia de Destino</label>
                            <input type="text" id="malharia_nome_display" class="form-control shadow-sm bg-light text-danger fw-bold border-danger border-opacity-50" readonly>
                            <input type="hidden" name="malharia_id" id="malharia_id_hidden">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-secondary"><i class="bi bi-calendar-event"></i> Data de Envio/Corte</label>
                            <input type="date" name="data_corte" class="form-control shadow-sm border-danger border-opacity-50" value="<%= new Date().toISOString().split('T')[0] %>" required>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2 mt-4">
                        <h6 class="fw-bold text-dark m-0"><i class="bi bi-list-check"></i> Produtos Cortados Neste Lote</h6>
                        <button type="button" class="btn btn-success shadow-sm fw-bold" id="btnBuscarProdutos" disabled onclick="abrirModalBusca()">
                            <i class="bi bi-search"></i> Adicionar Produtos
                        </button>
                    </div>

                    <div class="table-responsive bg-white border rounded shadow-sm mb-4 table-scrollable">
                        <table class="table table-hover align-middle mb-0" id="tabelaListaCortes">
                            <thead class="table-dark position-sticky top-0 shadow-sm" style="z-index: 10;">
                                <tr>
                                    <th class="ps-3" style="width: 50px;">Arte</th>
                                    <th>Processo / Órgão</th>
                                    <th>Produto & Descrição</th>
                                    <th class="text-center" style="width: 140px;">Qtd. Cortada</th>
                                    <th class="text-center" style="width: 60px;">X</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="linhaVaziaCortes">
                                    <td colspan="5" class="text-center py-4 text-muted fst-italic">Busque os produtos para registrar o envio.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mb-2 p-3 bg-white border border-danger border-opacity-50 rounded shadow-sm">
                        <label class="form-label text-danger fw-bold small"><i class="bi bi-file-earmark-pdf"></i> Comprovante do Lote (PDF) <span class="text-danger">* OBRIGATÓRIO</span></label>
                        <input type="file" name="documento_comprovante" class="form-control" accept="application/pdf" required>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm" id="btnSalvarCorte"><i class="bi bi-check-circle"></i> Salvar Lote</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edição -->
<div class="modal fade" id="modalEditarCorte" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square"></i> Editar Lançamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditarCorte" method="POST" enctype="multipart/form-data">
                <div class="modal-body bg-light">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Nova Quantidade</label>
                            <input type="number" name="quantidade" id="edit_quantidade" class="form-control fw-bold text-primary border-primary border-opacity-50 shadow-sm" min="1" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Data do Lançamento</label>
                            <input type="date" name="data_corte" id="edit_data_corte" class="form-control shadow-sm" required>
                        </div>
                    </div>
                    <div class="mb-2 p-3 bg-white border rounded shadow-sm">
                        <label class="form-label text-secondary fw-bold small"><i class="bi bi-file-earmark-pdf"></i> Substituir Comprovante (Opcional)</label>
                        <input type="file" name="documento_comprovante" class="form-control" accept="application/pdf">
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm" id="btnSalvarEdicao"><i class="bi bi-check-circle"></i> Atualizar Dados</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal BUSCA -->
<div class="modal fade" id="modalBuscaProdutos" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-check2-square"></i> Produtos Permitidos</h5>
                <button type="button" class="btn-close btn-close-white" onclick="voltarParaModalCorte()"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="mb-3">
                    <input type="text" id="inputBuscaModalCorte" class="form-control form-control-lg shadow-sm" placeholder="Buscar..." onkeyup="filtrarModalProdutos()">
                </div>
                <div class="table-responsive bg-white rounded border table-scrollable">
                    <table class="table table-hover table-sm align-middle mb-0" id="tabelaModalCortes">
                        <thead class="table-light position-sticky top-0 shadow-sm" style="z-index: 10;">
                            <tr>
                                <th style="width: 50px;" class="text-center"><input type="checkbox" class="form-check-input" id="checkAllModalCorte" onclick="toggleAllModalCortes(this)"></th>
                                <th style="width: 60px;" class="text-center">Arte</th>
                                <th>Processo / Órgão</th>
                                <th>Produto</th>
                                <th>Qtd. Original do Pedido</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyModalCortes"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" onclick="voltarParaModalCorte()">Voltar</button>
                <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" onclick="adicionarCortesSelecionados()"><i class="bi bi-plus-circle"></i> Adicionar à Lista</button>
            </div>
        </div>
    </div>
</div>

<script>
    const todosItens = <%- todosItensJSON %>;
    const processosAtivos = <%- processosAtivosJSON %>;
    let maquinasDaMalharia = [];
    let combinacoesFiltradas = [];
    let listaCortesCarrinho = [];

    function ocultarTodasAsTelas() { document.querySelectorAll('.view-section').forEach(el => el.classList.add('d-none')); }
    function mostrarMalharias() { ocultarTodasAsTelas(); document.getElementById('view-malharias').classList.remove('d-none'); }
    function abrirProdutos(malhariaId) { ocultarTodasAsTelas(); document.getElementById('view-produtos-' + malhariaId).classList.remove('d-none'); }

    function pesquisarCards(inputElement, containerId) {
        const termo = inputElement.value.toLowerCase().trim();
        const container = document.getElementById(containerId);
        if(!container) return;
        container.querySelectorAll('.item-pesquisavel').forEach(card => card.style.display = card.getAttribute('data-search').includes(termo) ? '' : 'none');
    }

    function prepararNovoCorte(malhariaId, malhariaNome) {
        document.getElementById('malharia_id_hidden').value = malhariaId;
        document.getElementById('malharia_nome_display').value = malhariaNome;
        listaCortesCarrinho = [];
        atualizarTabelaCarrinho();
        carregarMaquinasEAtivarBusca(malhariaId);
        
        const modalEl = document.getElementById('modalNovoCorte');
        let modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    function abrirModalEdicao(idCorte, quantidadeAtual, dataCorteAtual) {
        document.getElementById('formEditarCorte').action = `/cortes/${idCorte}/update`;
        document.getElementById('edit_quantidade').value = quantidadeAtual;
        document.getElementById('edit_data_corte').value = dataCorteAtual;
        const modalEl = document.getElementById('modalEditarCorte');
        let modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    async function carregarMaquinasEAtivarBusca(malhariaId) {
        const btnBusca = document.getElementById('btnBuscarProdutos');
        btnBusca.disabled = true;
        btnBusca.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        try {
            const res = await fetch(`/registros/api/malharia-info/${malhariaId}`);
            const data = await res.json();
            maquinasDaMalharia = data.itens || [];
            btnBusca.disabled = false;
            btnBusca.innerHTML = '<i class="bi bi-search"></i> Adicionar Produtos';
        } catch (e) { alert("Falha ao analisar máquinas da oficina."); }
    }

    function abrirModalBusca() {
        combinacoesFiltradas = [];
        const checkAll = document.getElementById('checkAllModalCorte');
        if (checkAll) checkAll.checked = false;

        processosAtivos.forEach(p => {
            if (p.itens) {
                p.itens.forEach((pi) => {
                    const dadosItem = todosItens.find(i => String(i.id) === String(pi.item_id));
                    if (dadosItem) {
                        let temMaquinaNecessaria = true;
                        if (dadosItem.maquinas && dadosItem.maquinas.length > 0) {
                            const idsMaquinasProduto = dadosItem.maquinas.map(m => String(m.maquinario_id || m.maquina?.id));
                            const idsMaquinasOficina = maquinasDaMalharia.filter(m => m.status !== 'indisponivel').map(m => String(m.maquinario_id || m.maquinario?.id));
                            temMaquinaNecessaria = idsMaquinasProduto.some(id => idsMaquinasOficina.includes(id));
                        }

                        if (temMaquinaNecessaria) {
                            combinacoesFiltradas.push({
                                processo_id: p.id, processo_item_id: pi.id,
                                numero_processo: p.numero_processo || 'S/N', orgao: p.orgao,
                                item_id: dadosItem.id, nome_produto: dadosItem.nome,
                                descricao: pi.descricao || '', tamanho: pi.tamanho || '',
                                solicitado: pi.qtd_solicitada || 0, id_unico: `${p.id}_${pi.id}`
                            });
                        }
                    }
                });
            }
        });

        renderizarModalBusca();
        
        const m1 = bootstrap.Modal.getInstance(document.getElementById('modalNovoCorte'));
        if (m1) m1.hide();
        setTimeout(() => {
            const m2El = document.getElementById('modalBuscaProdutos');
            let m2 = bootstrap.Modal.getInstance(m2El) || new bootstrap.Modal(m2El);
            m2.show();
        }, 400);
    }

    function voltarParaModalCorte() {
        const m2 = bootstrap.Modal.getInstance(document.getElementById('modalBuscaProdutos'));
        if (m2) m2.hide();
        setTimeout(() => {
            const m1El = document.getElementById('modalNovoCorte');
            let m1 = bootstrap.Modal.getInstance(m1El) || new bootstrap.Modal(m1El);
            m1.show();
        }, 400);
    }

    function renderizarModalBusca() {
        const tbody = document.getElementById('tbodyModalCortes');
        tbody.innerHTML = '';
        if (combinacoesFiltradas.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4">Nenhum produto compatível com as máquinas.</td></tr>'; return;
        }

        combinacoesFiltradas.forEach(comb => {
            if (!listaCortesCarrinho.some(c => String(c.id_unico) === String(comb.id_unico))) {
                tbody.innerHTML += `
                    <tr class="linha-busca-corte" data-search="${`${comb.nome_produto} ${comb.numero_processo} ${comb.orgao} ${comb.tamanho}`.toLowerCase()}">
                        <td class="text-center align-middle"><input type="checkbox" class="form-check-input check-corte" value="${comb.id_unico}"></td>
                        <td class="text-center align-middle p-1"><i class="bi bi-box text-muted fs-4"></i></td>
                        <td class="align-middle"><span class="fw-bold text-primary">${comb.numero_processo}</span><br><small class="text-muted">${comb.orgao}</small></td>
                        <td class="align-middle"><span class="fw-bold text-dark">${comb.nome_produto}</span> ${comb.tamanho && comb.tamanho !== '-' ? `<span class="badge bg-secondary ms-1">${comb.tamanho}</span>` : ''}</td>
                        <td class="align-middle fw-bold text-dark">Pedido: ${comb.solicitado} un</td>
                    </tr>
                `;
            }
        });
    }

    function filtrarModalProdutos() {
        const termo = document.getElementById('inputBuscaModalCorte').value.toLowerCase().trim();
        document.querySelectorAll('.linha-busca-corte').forEach(linha => {
            linha.style.display = linha.getAttribute('data-search').includes(termo) ? '' : 'none';
        });
    }

    function toggleAllModalCortes(source) {
        document.querySelectorAll('#tbodyModalCortes .check-corte').forEach(cb => {
            if (cb.closest('tr').style.display !== 'none') cb.checked = source.checked;
        });
    }

    function adicionarCortesSelecionados() {
        const selecionados = document.querySelectorAll('#tbodyModalCortes .check-corte:checked');
        if(selecionados.length === 0) { alert("Selecione pelo menos um produto na lista."); return; }
        
        selecionados.forEach(function(cb) {
            const comb = combinacoesFiltradas.find(c => String(c.id_unico) === String(cb.value));
            if (comb) listaCortesCarrinho.push({ ...comb, qtd_corte: comb.solicitado }); 
        });
        
        atualizarTabelaCarrinho();
        voltarParaModalCorte();
    }

    function removerDoCarrinho(index) {
        listaCortesCarrinho.splice(index, 1);
        atualizarTabelaCarrinho();
    }

    function atualizarTabelaCarrinho() {
        const tbody = document.querySelector('#tabelaListaCortes tbody');
        if (listaCortesCarrinho.length === 0) {
            tbody.innerHTML = `<tr id="linhaVaziaCortes"><td colspan="5" class="text-center py-4 text-muted fst-italic">Busque os produtos para registrar o envio.</td></tr>`;
            return;
        }

        tbody.innerHTML = '';
        listaCortesCarrinho.forEach((prod, index) => {
            tbody.innerHTML += `
                <tr>
                    <td class="text-center align-middle p-1"><i class="bi bi-box text-muted fs-4"></i></td>
                    <td class="align-middle"><span class="fw-bold text-primary">${prod.numero_processo}</span><div class="small text-muted">${prod.orgao}</div></td>
                    <td class="align-middle">
                        <span class="fw-bold text-dark">${prod.nome_produto}</span> ${prod.tamanho && prod.tamanho !== '-' ? `<span class="badge bg-secondary ms-1">${prod.tamanho}</span>` : ''}
                        <input type="hidden" name="processos_ids[]" value="${prod.processo_id}">
                        <input type="hidden" name="processo_item_ids[]" value="${prod.processo_item_id}">
                        <input type="hidden" name="itens_ids[]" value="${prod.item_id}">
                    </td>
                    <td class="align-middle text-center">
                        <input type="number" name="quantidades[]" class="form-control text-center fw-bold text-danger border-danger" value="${prod.qtd_corte}" min="1" required>
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="removerDoCarrinho(${index})"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            `;
        });
    }

    function validarEnvio() {
        if (listaCortesCarrinho.length === 0) { alert("Atenção: Adicione pelo menos um produto na lista."); return false; }
        document.getElementById('btnSalvarCorte').innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processando...';
        document.getElementById('btnSalvarCorte').disabled = true;
        return true;
    }

    document.getElementById('formEditarCorte').addEventListener('submit', function() {
        const btn = document.getElementById('btnSalvarEdicao');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        btn.disabled = true;
    });
</script>