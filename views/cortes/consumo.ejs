<style>
    .calendario-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
    .calendario-header { text-align: center; font-weight: bold; padding: 5px; background: #f8f9fa; border-radius: 4px; color: #495057;}
    .calendario-dia { border: 1px solid #e9ecef; min-height: 80px; padding: 8px; border-radius: 6px; display:flex; flex-direction:column; background: #fff; transition: all 0.2s ease-in-out;}
    .calendario-dia.interativo { cursor: pointer; }
    .calendario-dia.interativo:hover { background-color: #f1f3f5; border-color: #dee2e6; transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .calendario-dia.dia-ativo { border: 2px solid #0d6efd; background-color: #f0f7ff; box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2); }
    .calendario-dia.outro-mes { background-color: #f8f9fa; color: #adb5bd; border-style: dashed; pointer-events: none; }
    .dia-numero { font-weight: 700; font-size: 1.1em; color: #343a40; }
    .dia-ativo .dia-numero { color: #0d6efd; }
    .badge-status { font-size: 0.75rem; padding: 4px; margin-top: auto; text-align: center; border-radius: 4px; font-weight: bold; width: 100%; }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="bi bi-box-arrow-right text-primary"></i> Consumo de Cortes na Costura</h1>
</div>

<ul class="nav nav-pills mb-4 shadow-sm bg-white rounded p-1 border">
    <li class="nav-item">
        <a class="nav-link text-dark fw-bold" href="/cortes">
            <i class="bi bi-box-arrow-in-down"></i> Entradas / Envios de Cortes
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active bg-primary text-white fw-bold" href="/cortes/consumo">
            <i class="bi bi-box-arrow-right"></i> Consumo na Costura
        </a>
    </li>
</ul>

<!-- CALENDÁRIO -->
<div class="card shadow-sm mb-4 border-primary border-top border-3">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
        <button class="btn btn-sm btn-outline-secondary px-3" onclick="mudarMes(-1)"><i class="bi bi-chevron-left"></i> Anterior</button>
        <h5 class="mb-0 fw-bold text-dark text-uppercase" id="mesAnoAtual"></h5>
        <button class="btn btn-sm btn-outline-secondary px-3" onclick="mudarMes(1)">Próximo <i class="bi bi-chevron-right"></i></button>
    </div>
    <div class="card-body p-2 p-md-3 bg-light">
        <div id="calendarioGrid" class="calendario-grid"></div>
    </div>
</div>

<div class="row">
    <!-- COLUNA 1: BAIXAS DO DIA -->
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="text-primary fw-bold m-0"><i class="bi bi-card-checklist"></i> Consumos do dia <%= dataBusca.split('-').reverse().join('/') %></h4>
            
            <!-- BOTÃO MÁGICO DE SINCRONIZAÇÃO DA PRODUÇÃO -->
            <form action="/cortes/consumo/sync" method="POST" onsubmit="return confirm('Isso vai ler todo o Registro Diário da produção de <%= dataBusca.split('-').reverse().join('/') %> e dar a baixa automática nos estoques de corte correspondentes. Deseja continuar?');">
                <input type="hidden" name="data_baixa" value="<%= dataBusca %>">
                <button type="submit" class="btn btn-success fw-bold shadow-sm px-3" title="Sincronizar com as metas batidas hoje">
                    <i class="bi bi-arrow-repeat"></i> Auto-Preencher pela Produção
                </button>
            </form>
        </div>
        
        <% if (baixasDoDia.length === 0) { %>
            <div class="alert alert-secondary text-center py-4 border-dashed bg-light">
                <i class="bi bi-inbox display-4 text-muted d-block mb-3 opacity-25"></i>
                <h5 class="text-secondary">Nenhuma baixa de corte registrada para este dia.</h5>
            </div>
        <% } else { %>
            <div class="list-group shadow-sm">
                <% baixasDoDia.forEach(b => { %>
                    <div class="list-group-item border-start border-4 border-primary">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold mb-1"><%= b.item_origem.item.nome %> <span class="badge bg-secondary"><%= b.item_origem.tamanho %></span></h6>
                                <small class="text-muted"><i class="bi bi-shop"></i> <%= b.malharia.nome %> | Proc Original: <b><%= b.item_origem.processo.numero_processo %></b></small>
                            </div>
                            <span class="badge bg-primary fs-6 shadow-sm px-3"><i class="bi bi-check2-circle"></i> Consumiu: <%= b.quantidade %> un</span>
                        </div>
                        
                        <div class="bg-light p-2 rounded small mt-2 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-secondary d-block"><i class="bi bi-arrow-return-right"></i> <b>Destinado para:</b> <%= b.item_destino.item.nome %> (<%= b.item_destino.tamanho %>) - Proc <%= b.item_destino.processo.numero_processo %></span>
                                <span class="text-muted d-block mt-1"><i class="bi bi-person"></i> Lancado por: <%= b.solicitante.nome %></span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-2">
                                <% if (b.status === 'pendente') { %>
                                    <span class="badge bg-warning text-dark">Pendente Aprovação</span>
                                    <% if (locals.user && user.nivel >= 3) { %>
                                        <form action="/cortes/consumo/<%= b.id %>/aprovar" method="POST"><button class="btn btn-sm btn-success py-0"><i class="bi bi-check-lg"></i></button></form>
                                        <form action="/cortes/consumo/<%= b.id %>/rejeitar" method="POST"><button class="btn btn-sm btn-danger py-0"><i class="bi bi-x-lg"></i></button></form>
                                    <% } %>
                                <% } else if (b.status === 'aprovada') { %>
                                    <span class="badge bg-success"><i class="bi bi-shield-check"></i> Auditado por <%= b.avaliador?.nome %></span>
                                <% } else { %>
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Rejeitado por <%= b.avaliador?.nome %></span>
                                <% } %>

                                <% if (locals.user && user.nivel >= 3) { %>
                                    <button class="btn btn-sm btn-outline-primary py-0" title="Editar Destino/Qtd" onclick="abrirModalEdicaoBaixa('<%= b.id %>', '<%= b.quantidade %>', '<%= b.data_baixa %>', '<%= b.processo_item_destino_id %>')"><i class="bi bi-pencil"></i></button>
                                    <form action="/cortes/consumo/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Apagar este registro de consumo? O saldo voltará para o estoque.');">
                                        <button class="btn btn-sm btn-outline-secondary py-0"><i class="bi bi-trash"></i></button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- COLUNA 2: SALDOS PARA BAIXA MANUAL -->
    <div class="col-md-4">
        <h4 class="text-secondary mb-3"><i class="bi bi-box-seam"></i> Saldo Disponível</h4>
        <div class="accordion shadow-sm" id="accordionSaldos">
            <% 
                let estJson = JSON.parse(estoqueDisponivelJSON);
                let count = 0;
            %>
            <% malharias.forEach(m => { %>
                <% if (estJson[m.id] && Object.keys(estJson[m.id]).length > 0) { count++; %>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-<%= m.id %>">
                            <button class="accordion-button <%= count===1 ? '' : 'collapsed' %> fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= m.id %>">
                                <i class="bi bi-shop me-2 text-primary"></i> <%= m.nome %>
                            </button>
                        </h2>
                        <div id="collapse-<%= m.id %>" class="accordion-collapse collapse <%= count===1 ? 'show' : '' %>" data-bs-parent="#accordionSaldos">
                            <div class="accordion-body p-0">
                                <ul class="list-group list-group-flush">
                                    <% Object.values(estJson[m.id]).forEach(item => { %>
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-light">
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.85rem;"><%= item.nome_produto %> <span class="badge bg-secondary"><%= item.tamanho %></span></h6>
                                                <small class="text-muted" style="font-size: 0.70rem;">Proc: <%= item.numero_processo %></small>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-success d-block mb-1 fs-6"><%= item.disponivel %> un</span>
                                                <button class="btn btn-sm btn-outline-primary fw-bold py-0 w-100" style="font-size: 0.70rem;" onclick="abrirModalConsumo('<%= m.id %>', '<%= m.nome %>', '<%= item.processo_item_id %>', '<%= item.nome_produto %>', '<%= item.tamanho %>', '<%= item.numero_processo %>', <%= item.disponivel %>)">
                                                    Baixa Manual
                                                </button>
                                            </div>
                                        </li>
                                    <% }) %>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% }) %>
            <% if (count === 0) { %>
                <div class="alert alert-secondary text-center m-0 border-0 rounded-0">
                    Nenhum saldo de corte disponível no momento.
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- MODAL LANÇAR BAIXA MANUAL -->
<div class="modal fade" id="modalBaixaCorte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-box-arrow-right"></i> Lançar Baixa Manual</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/cortes/consumo/store" method="POST">
                <div class="modal-body bg-light">
                    <input type="hidden" name="malharia_id" id="baixa_malharia_id">
                    <input type="hidden" name="processo_item_origem_id" id="baixa_origem_id">
                    <input type="hidden" name="data_baixa" value="<%= dataBusca %>">

                    <div class="p-3 bg-white border border-primary border-opacity-50 rounded shadow-sm text-center mb-3">
                        <small class="text-muted d-block text-uppercase fw-bold mb-1">Tecido Original (<span id="baixa_malharia_nome" class="text-primary"></span>)</small>
                        <h5 class="fw-bold text-dark m-0" id="baixa_produto_nome"></h5>
                        <small class="text-secondary">Processo: <b id="baixa_processo_nome"></b></small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 text-center">
                            <label class="form-label fw-bold small text-secondary">Quantidade transformada em peça:</label>
                            <input type="number" name="quantidade" id="baixa_quantidade" class="form-control form-control-lg text-center fw-bold text-primary-emphasis border-primary" required min="1">
                            <div class="form-text small">Disponível em Estoque: <b id="baixa_max_qtd"></b></div>
                        </div>
                    </div>

                    <div class="mb-2 p-3 bg-white border rounded shadow-sm">
                        <label class="form-label text-dark fw-bold small"><i class="bi bi-arrow-return-right text-primary"></i> Peça Costurada (Destinação)</label>
                        <select name="processo_item_destino_id" id="baixa_destino_id" class="form-select" required></select>
                        <div class="form-text small">Caso o corte tenha sido reaproveitado para outro pedido, altere a destinação final acima.</div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm"><i class="bi bi-check-circle"></i> Confirmar Baixa</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDITAR BAIXA -->
<div class="modal fade" id="modalEditarBaixa" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square"></i> Editar Registro de Consumo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditarBaixa" method="POST">
                <div class="modal-body bg-light">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Ajustar Quantidade</label>
                            <input type="number" name="quantidade" id="edit_baixa_quantidade" class="form-control fw-bold border-secondary shadow-sm" min="1" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Alterar Data</label>
                            <input type="date" name="data_baixa" id="edit_baixa_data" class="form-control shadow-sm" required>
                        </div>
                    </div>
                    <div class="mb-2 p-3 bg-white border rounded shadow-sm">
                        <label class="form-label text-dark fw-bold small"><i class="bi bi-arrow-return-right text-primary"></i> Corrigir Produto Destino</label>
                        <select name="processo_item_destino_id" id="edit_baixa_destino_id" class="form-select" required></select>
                        <div class="form-text small">Altere caso o corte tenha sido usado para fechar um produto ou processo diferente do original.</div>
                    </div>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-secondary px-4 fw-bold shadow-sm"><i class="bi bi-check-circle"></i> Atualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const dataBusca = "<%= dataBusca %>";
    const resumoDatas = <%- resumoCalendarioJSON %>;
    const processosAtivos = <%- processosAtivosJSON %>;
    
    let currentViewDate = new Date(dataBusca + "T12:00:00");

    function pad(n) { return n < 10 ? '0'+n : n; }
    function toDateStr(d) { return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); }

    function mudarMes(delta) {
        let currentMonth = currentViewDate.getMonth();
        currentViewDate.setMonth(currentMonth + delta, 1); 
        renderCalendar();
    }

    function renderCalendar() {
        const currentMonth = currentViewDate.getMonth();
        const currentYear = currentViewDate.getFullYear();
        const firstDay = new Date(currentYear, currentMonth, 1);
        const lastDay = new Date(currentYear, currentMonth + 1, 0);
        const monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
        
        document.getElementById('mesAnoAtual').innerText = `${monthNames[currentMonth]} ${currentYear}`;
        const grid = document.getElementById('calendarioGrid');
        grid.innerHTML = '';
        
        ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'].forEach(d => {
            grid.innerHTML += `<div class="calendario-header">${d}</div>`;
        });
        
        for(let i = 0; i < firstDay.getDay(); i++) {
            grid.innerHTML += `<div class="calendario-dia outro-mes"></div>`;
        }

        for(let day = 1; day <= lastDay.getDate(); day++) {
            let loopDate = new Date(currentYear, currentMonth, day, 12, 0, 0);
            let loopDateStr = toDateStr(loopDate);
            
            let isAtivo = loopDateStr === dataBusca ? 'dia-ativo' : '';
            let isFolga = loopDate.getDay() === 0 || loopDate.getDay() === 6;
            
            let temBaixa = resumoDatas.includes(loopDateStr);
            let bolinha = temBaixa ? `<div class="badge-status bg-primary text-white mt-1 shadow-sm"><i class="bi bi-check2-circle"></i> Consumo</div>` : '';
            if (isFolga && !temBaixa) bolinha = `<div class="badge-status bg-light text-muted border mt-1 shadow-sm">FDS</div>`;

            grid.innerHTML += `
                <div class="calendario-dia interativo ${isAtivo}" onclick="window.location.href='/cortes/consumo?data=${loopDateStr}'">
                    <div class="dia-numero">${day}</div>
                    ${bolinha}
                </div>
            `;
        }
    }
    
    document.addEventListener('DOMContentLoaded', renderCalendar);

    function abrirModalConsumo(mId, mNome, piId, nomeProduto, tamanho, numProc, maxDisponivel) {
        document.getElementById('baixa_malharia_id').value = mId;
        document.getElementById('baixa_origem_id').value = piId;
        document.getElementById('baixa_malharia_nome').innerText = mNome;
        document.getElementById('baixa_produto_nome').innerText = `${nomeProduto} ${tamanho !== '-' ? `(Tam: ${tamanho})` : ''}`;
        document.getElementById('baixa_processo_nome').innerText = numProc;
        
        const inputQtd = document.getElementById('baixa_quantidade');
        inputQtd.max = maxDisponivel;
        inputQtd.value = '';
        document.getElementById('baixa_max_qtd').innerText = maxDisponivel + ' unidades';

        const selectDestino = document.getElementById('baixa_destino_id');
        selectDestino.innerHTML = '';
        
        processosAtivos.forEach(p => {
            if (p.itens) {
                p.itens.forEach(pi => {
                    const selected = String(pi.id) === String(piId) ? 'selected' : '';
                    const desc = pi.descricao ? ` - ${pi.descricao}` : '';
                    const tam = pi.tamanho && pi.tamanho !== '-' ? ` (${pi.tamanho})` : '';
                    const nomeStr = pi.item ? pi.item.nome : 'Item';
                    selectDestino.innerHTML += `<option value="${pi.id}" ${selected}>[Proc: ${p.numero_processo}] ${nomeStr}${tam}${desc}</option>`;
                });
            }
        });

        new bootstrap.Modal(document.getElementById('modalBaixaCorte')).show();
    }

    function abrirModalEdicaoBaixa(idBaixa, qtd, dataBaixa, piDestinoId) {
        document.getElementById('formEditarBaixa').action = `/cortes/consumo/${idBaixa}/update`;
        document.getElementById('edit_baixa_quantidade').value = qtd;
        document.getElementById('edit_baixa_data').value = dataBaixa;

        const selectDestino = document.getElementById('edit_baixa_destino_id');
        selectDestino.innerHTML = '';
        
        processosAtivos.forEach(p => {
            if (p.itens) {
                p.itens.forEach(pi => {
                    const selected = String(pi.id) === String(piDestinoId) ? 'selected' : '';
                    const desc = pi.descricao ? ` - ${pi.descricao}` : '';
                    const tam = pi.tamanho && pi.tamanho !== '-' ? ` (${pi.tamanho})` : '';
                    const nomeStr = pi.item ? pi.item.nome : 'Item';
                    selectDestino.innerHTML += `<option value="${pi.id}" ${selected}>[Proc: ${p.numero_processo}] ${nomeStr}${tam}${desc}</option>`;
                });
            }
        });

        new bootstrap.Modal(document.getElementById('modalEditarBaixa')).show();
    }
</script>