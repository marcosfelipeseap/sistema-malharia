<script>
let rxChartInst = null;
let rxGlobalDaysMap = {}; 
let currentSelectedWeekStart = null;
let lastSelectedOficina = null;
let rxFilteredDataGlobal = []; // Auxiliar para tooltips do gráfico

const diasDaSemanaNome = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];

// Função de segurança caso isSemInsumo não exista no escopo
function safeIsSemInsumo(justificativa) {
    if (typeof isSemInsumo === 'function') return isSemInsumo(justificativa);
    if (!justificativa) return false;
    let j = justificativa.toLowerCase();
    return j.includes('sem insumo') || j.includes('falta de insumo') || j.includes('material');
}

function getMonday(d) {
    d = new Date(d);
    let day = d.getDay();
    let diff = d.getDate() - day + (day === 0 ? -6 : 1);
    return new Date(d.setDate(diff));
}

function getWeekNumber(d) {
    let target = new Date(d.valueOf());
    let dayNr = (d.getDay() + 6) % 7;
    target.setDate(target.getDate() - dayNr + 3);
    let firstThursday = target.valueOf();
    target.setMonth(0, 1);
    if (target.getDay() !== 4) { target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7); }
    return 1 + Math.ceil((firstThursday - target) / 604800000);
}

function setupRxDropdown(oficinas) {
    let optsContainer = document.getElementById('rxOptionsContainer');
    optsContainer.innerHTML = '';
    oficinas.forEach(of => {
        let optDiv = document.createElement('div');
        optDiv.className = 'custom-option';
        optDiv.innerText = of;
        optDiv.onclick = (e) => {
            e.stopPropagation();
            document.getElementById('rxSelectedText').innerText = of;
            document.getElementById('rxSelectedText').style.color = "var(--primary)";
            document.getElementById('rxOficinaSelect').value = of;
            document.getElementById('rxDropdownContent').style.display = 'none';
            renderPageOficina();
        };
        optsContainer.appendChild(optDiv);
    });
}

function toggleRxDropdown() {
    let content = document.getElementById('rxDropdownContent');
    let isHidden = content.style.display === 'none' || content.style.display === '';
    if (isHidden) {
        content.style.display = 'flex';
        document.getElementById('rxSearchInput').value = '';
        filterRxOptions(); 
        setTimeout(() => document.getElementById('rxSearchInput').focus(), 50);
    } else {
        content.style.display = 'none';
    }
}

function filterRxOptions(e) {
    if (e) e.stopPropagation();
    let query = document.getElementById('rxSearchInput').value.toLowerCase();
    let opts = document.querySelectorAll('#rxOptionsContainer .custom-option');
    opts.forEach(opt => {
        if (opt.innerText.toLowerCase().includes(query)) opt.style.display = 'block';
        else opt.style.display = 'none';
    });
}

document.addEventListener('click', function(event) {
    let dropdown = document.getElementById('rxDropdown');
    let content = document.getElementById('rxDropdownContent');
    if (dropdown && content && !dropdown.contains(event.target)) content.style.display = 'none';
});

function filterRxHistory() {
    let query = document.getElementById('rxDateSearch').value.toLowerCase();
    let rows = document.querySelectorAll('#rxTableBody tr');
    rows.forEach(r => {
        if (r.innerText.toLowerCase().includes(query)) r.style.display = '';
        else r.style.display = 'none';
    });
}

function changeRxWeek(offset) {
    if (!currentSelectedWeekStart) return;
    currentSelectedWeekStart.setDate(currentSelectedWeekStart.getDate() + (offset * 7));
    renderWeeklyBanner();
}

function generateSemanaRelatorio() {
    if (!currentSelectedWeekStart) {
        alert("Selecione uma oficina e aguarde o carregamento dos dados para gerar o relatório.");
        return;
    }

    let val = document.getElementById('rxOficinaSelect').value;
    let start = new Date(currentSelectedWeekStart);
    let end = new Date(start);
    end.setDate(end.getDate() + 6);

    let weekNo = getWeekNumber(start);
    let fmt = date => String(date.getDate()).padStart(2,'0') + '/' + String(date.getMonth()+1).padStart(2,'0');
    let fmtFull = date => String(date.getDate()).padStart(2,'0') + '/' + String(date.getMonth()+1).padStart(2,'0') + '/' + date.getFullYear();
    
    let weekProd = 0;
    let weekMeta = 0;
    let weekDaysCount = 0;
    let daysText = '';

    for(let i=0; i<7; i++) {
        let currDate = new Date(start);
        currDate.setDate(currDate.getDate() + i);
        
        let dStr = fmtFull(currDate);
        let shortDate = fmt(currDate);
        let dayName = diasDaSemanaNome[i];
        let isWeekend = (i === 5 || i === 6); 

        daysText += `🗓 *${dayName} (${shortDate})*\n`;

        if (rxGlobalDaysMap[dStr]) {
            let inf = rxGlobalDaysMap[dStr];
            weekProd += inf.prod;
            weekMeta += inf.meta; 
            weekDaysCount++;

            let bateu = inf.prod > 0 && inf.prod >= inf.meta;
            let isInsumo = inf.prod === 0 && inf.justs.some(j => safeIsSemInsumo(j));

            let statusText = '❌ FALHA';
            if(bateu) statusText = '✅ OK';
            else if(isInsumo) statusText = '⚠️ S/I';

            let perc = inf.meta > 0 ? Math.round((inf.prod/inf.meta)*100) : (isInsumo ? 0 : 100);

            daysText += `Status: ${statusText} (${inf.prod} / ${inf.meta}) - ${perc}%\n`;
            
            inf.items.forEach(it => {
                if(it.item !== 'Nenhum') {
                    daysText += `- ${it.producaoDia}x ${it.item} (${it.tipo || 'Planilha'})\n`;
                }
            });
            
            let uniqJ = [...new Set(inf.justs)].filter(j => j && j.trim() !== "");
            if(!bateu) {
                if(uniqJ.length > 0) daysText += `Motivo: ${uniqJ.join(', ')}\n`;
                else daysText += `Motivo: Não informado\n`;
            }
        } else {
            if (isWeekend) {
                daysText += `Sem Expediente\n`;
            } else {
                daysText += `⚪ Sem Relatório\n`;
            }
        }
        daysText += `\n`;
    }

    let weekPerf = weekMeta > 0 ? Math.round((weekProd / weekMeta) * 100) : (weekProd > 0 ? 100 : 0);

    let text = `*📊 RELATÓRIO SEMANAL - ${val}*\n`;
    text += `*Semana ${weekNo} (${fmt(start)} a ${fmt(end)})*\n\n`;
    
    text += `*Resumo da Semana:*\n`;
    text += `Produção: ${weekProd}\n`;
    text += `Meta: ${weekMeta}\n`;
    text += `Performance: ${weekPerf}%\n`;
    text += `Dias Trabalhados: ${weekDaysCount}\n\n`;

    text += `*--- DETALHES POR DIA ---*\n\n`;
    text += daysText;

    if (typeof openWhatsModal === 'function') {
        openWhatsModal(text.trim());
    } else {
        alert("Função de WhatsApp não encontrada. O texto do relatório é:\n\n" + text.trim());
    }
}

function renderWeeklyBanner() {
    if (!currentSelectedWeekStart) {
        document.getElementById('rxWeekBanner').style.display = 'none';
        return;
    }

    document.getElementById('rxWeekBanner').style.display = 'flex';

    let start = new Date(currentSelectedWeekStart);
    let end = new Date(start);
    end.setDate(end.getDate() + 6);

    let weekNo = getWeekNumber(start);
    let fmt = date => String(date.getDate()).padStart(2,'0') + '/' + String(date.getMonth()+1).padStart(2,'0');
    
    document.getElementById('rxSemanaNum').innerText = 'Semana ' + weekNo;
    document.getElementById('rxSemanaDatas').innerText = fmt(start) + ' a ' + fmt(end);

    let weekProd = 0;
    let weekMeta = 0;
    let weekDaysCount = 0;
    let weekDaysHtml = '';

    for(let i=0; i<7; i++) {
        let currDate = new Date(start);
        currDate.setDate(currDate.getDate() + i);
        
        let dStr = String(currDate.getDate()).padStart(2,'0') + '/' + String(currDate.getMonth()+1).padStart(2,'0') + '/' + currDate.getFullYear();
        let shortDate = String(currDate.getDate()).padStart(2,'0') + '/' + String(currDate.getMonth()+1).padStart(2,'0');
        let dayName = diasDaSemanaNome[i];
        let isWeekend = (i === 5 || i === 6);

        if (rxGlobalDaysMap[dStr]) {
            let inf = rxGlobalDaysMap[dStr];
            weekProd += inf.prod;
            weekMeta += inf.meta;
            weekDaysCount++;

            let bateu = inf.prod > 0 && inf.prod >= inf.meta;
            let isInsumo = inf.prod === 0 && inf.justs.some(j => safeIsSemInsumo(j));

            let statusBadge = '';
            if(bateu) statusBadge = '<span style="background:#4CAF50; color:white; padding:4px 8px; border-radius:6px; font-size:0.6rem; font-weight:800; letter-spacing: 0.5px;">OK</span>';
            else if(isInsumo) statusBadge = '<span style="background:#FF9800; color:white; padding:4px 8px; border-radius:6px; font-size:0.6rem; font-weight:800; letter-spacing: 0.5px;">S/I</span>';
            else statusBadge = '<span style="background:#EF5350; color:white; padding:4px 8px; border-radius:6px; font-size:0.6rem; font-weight:800; letter-spacing: 0.5px;">FALHA</span>';

            let perc = inf.meta > 0 ? Math.round((inf.prod/inf.meta)*100) : (isInsumo ? 0 : 100);

            let itemsList = inf.items.map(it => {
                if (it.item === 'Nenhum') return '';
                return `<div style="margin-bottom:4px;"><b>${it.producaoDia}x</b> <span style="opacity:0.9">${it.item}</span></div>`;
            }).join('');
            
            let justHtml = '';
            let uniqJ = [...new Set(inf.justs)].filter(j => j && j.trim() !== "");
            if(!bateu) {
                let txtJust = uniqJ.length > 0 ? uniqJ.join(', ') : 'Não informado';
                justHtml = `<div class="rx-day-just"><b style="color:white;">Motivo:</b> ${txtJust}</div>`;
            }

            weekDaysHtml += `
            <div class="rx-day-card">
                <div class="rx-day-header">
                    <span>${dayName} <span style="opacity:0.6; font-size:0.75rem; font-weight:500; margin-left: 4px;">${shortDate}</span></span>
                    ${statusBadge}
                </div>
                <div class="rx-day-prod">
                    <span style="font-size:1.1rem; font-weight:800;">${inf.prod} <span style="font-size:0.7rem; font-weight:600; opacity:0.6;">/ ${inf.meta} m.</span></span>
                    <span style="font-weight:800; opacity:0.9; font-size: 0.9rem;">${perc}%</span>
                </div>
                <div class="rx-day-items">${itemsList}</div>
                ${justHtml}
            </div>`;

        } else {
            if (isWeekend) {
                weekDaysHtml += `
                <div class="rx-day-card missing weekend">
                    <div style="font-weight:800; margin-bottom:4px; text-transform: uppercase;">${dayName} <span style="opacity:0.6; font-size:0.75rem; font-weight:500; margin-left: 4px;">${shortDate}</span></div>
                    <div style="opacity:0.8; font-weight: 600;">Sem Expediente</div>
                </div>`;
            } else {
                weekDaysHtml += `
                <div class="rx-day-card missing">
                    <div style="font-weight:800; margin-bottom:4px; text-transform: uppercase;">${dayName} <span style="opacity:0.6; font-size:0.75rem; font-weight:500; margin-left: 4px;">${shortDate}</span></div>
                    <div style="opacity:0.8; font-weight: 600;">Sem Relatório</div>
                </div>`;
            }
        }
    }

    let weekPerf = weekMeta > 0 ? Math.round((weekProd / weekMeta) * 100) : (weekProd > 0 ? 100 : 0);

    document.getElementById('rxWeekProd').innerText = weekProd;
    document.getElementById('rxWeekMeta').innerText = weekMeta;
    document.getElementById('rxWeekPerf').innerText = weekPerf + '%';
    document.getElementById('rxWeekDays').innerText = weekDaysCount;
    document.getElementById('rxWeekDaysGrid').innerHTML = weekDaysHtml;
}

function renderPageOficina() {
    let globalData = (typeof rawData !== 'undefined') ? rawData : [];
    if (globalData.length === 0) return;

    let val = document.getElementById('rxOficinaSelect').value;
    
    if (!val) {
        let ofs = [...new Set(globalData.map(r => r.oficina))].sort();
        setupRxDropdown(ofs);
        val = ofs[0]; 
        document.getElementById('rxSelectedText').innerText = val;
        document.getElementById('rxSelectedText').style.color = "var(--primary)";
        document.getElementById('rxOficinaSelect').value = val;
    }

    if (val !== lastSelectedOficina) {
        currentSelectedWeekStart = null;
        lastSelectedOficina = val;
    }

    let datesFilter = typeof getFilterDates === 'function' ? getFilterDates() : { start: new Date(0), end: new Date() };
    
    // Mesclar dados do Sistema + dados Antigos (Planilha)
    let dadosCompletos = [...globalData];
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let antigosMarcados = dadosAntigos.map(d => ({ ...d, isPlanilha: true, metaOficina: d.meta || 0 }));
        dadosCompletos = [...dadosCompletos, ...antigosMarcados];
    }

    let filtered = dadosCompletos.filter(r => r.oficina === val && r.dateObj >= datesFilter.start && r.dateObj <= datesFilter.end);
    rxFilteredDataGlobal = filtered; // Salva para o tooltip do Gráfico

    rxGlobalDaysMap = {};
    filtered.forEach(r => {
        if (!rxGlobalDaysMap[r.data]) {
            rxGlobalDaysMap[r.data] = { prod: 0, intProd: r.internos || r.qtd_internos || 0, items: [], justs: [], obs: [] };
        }
        rxGlobalDaysMap[r.data].prod += (r.producaoDia || 0);
        rxGlobalDaysMap[r.data].items.push(r);
        if (r.justificativa) rxGlobalDaysMap[r.data].justs.push(r.justificativa);
        if (r.observacao) rxGlobalDaysMap[r.data].obs.push(r.observacao);
        rxGlobalDaysMap[r.data].intProd = Math.max(rxGlobalDaysMap[r.data].intProd, (r.internos || r.qtd_internos || 0));
    });

    let dateKeys = Object.keys(rxGlobalDaysMap).sort((a,b) => {
        let da=a.split('/'), db=b.split('/');
        return new Date(da[2],da[1]-1,da[0]) - new Date(db[2],db[1]-1,db[0]);
    });

    if (!currentSelectedWeekStart && dateKeys.length > 0) {
        let latestDate = dateKeys[dateKeys.length - 1];
        let pts = latestDate.split('/');
        currentSelectedWeekStart = getMonday(new Date(pts[2], pts[1]-1, pts[0]));
    }

    let totalProd = 0;
    let totalGlobalMeta = 0;
    let daysCount = dateKeys.length;
    let latestInt = 0;

    let refMetaRecord = filtered.find(r => r.metaOficina > 0);
    let refMeta = refMetaRecord ? refMetaRecord.metaOficina : 0;

    if (daysCount > 0) {
        latestInt = rxGlobalDaysMap[dateKeys[daysCount - 1]].intProd;
    }

    let trs = '';

    dateKeys.forEach(d => {
        let inf = rxGlobalDaysMap[d];
        let validItems = inf.items.filter(r => !(r.producaoDia === 0 && safeIsSemInsumo(r.justificativa)));
        inf.meta = (validItems.length > 0 && typeof calculateDynamicMeta === 'function') ? calculateDynamicMeta(validItems) : refMeta;
        
        totalProd += inf.prod;
        totalGlobalMeta += inf.meta;
    });

    renderWeeklyBanner();

    [...dateKeys].reverse().forEach(d => {
        let inf = rxGlobalDaysMap[d];
        
        let bateu = inf.prod > 0 && inf.prod >= inf.meta;
        let isInsumo = inf.prod === 0 && inf.justs.some(j => safeIsSemInsumo(j));
        
        let statusText = 'INSUFICIENTE';
        let statusColor = 'var(--danger-text)';
        let statusBg = 'var(--danger-bg)';
        if(bateu) { statusText = 'SATISFATÓRIO'; statusColor = 'var(--success-text)'; statusBg = 'var(--success-bg)';}
        else if(isInsumo) { statusText = 'SEM INSUMO'; statusColor = 'var(--warning-text-dark)'; statusBg = 'var(--warning-bg)';}

        let perc = inf.meta > 0 ? Math.round((inf.prod / inf.meta) * 100) : (isInsumo ? 0 : 100);
        let percColor = bateu ? 'var(--success-text)' : (isInsumo ? 'var(--warning-text-dark)' : 'var(--danger-text)');
        
        let itemsText = inf.items.map(i => {
            if (i.item === 'Nenhum') return '';
            let tipoLabel = i.isPlanilha ? 'Planilha' : (i.tipo || '-');
            return `<div style="margin-bottom:8px; font-size:0.85rem;"><b>${i.producaoDia}x</b> ${i.item} <span style="color:var(--text-muted); font-weight: 500;">(${tipoLabel})</span></div>`;
        }).join('');
        
        let uniqJ = [...new Set(inf.justs)].filter(j => j && j.trim() !== "");
        let uniqO = [...new Set(inf.obs)].filter(o => o && o.trim() !== "");
        
        let justHtml = '';
        if (!bateu && uniqJ.length > 0) {
            justHtml += `<div style="background: var(--danger-bg); border-left: 4px solid var(--danger-text); padding: 10px 15px; border-radius: 0 8px 8px 0; font-size: 0.8rem; color: var(--danger-text); margin-bottom: 8px;">
                            <span style="font-weight:700">Justificativa:</span> ${uniqJ.join(', ')}
                         </div>`;
        }
        
        if (uniqO.length > 0) {
            justHtml += `<div style="background: var(--neutral-bg); border-left: 4px solid var(--border); padding: 10px 15px; border-radius: 0 8px 8px 0; font-size: 0.8rem; color: var(--text-muted);">
                            <span style="font-weight:700; color: var(--text-main);">Obs:</span> ${uniqO.join(' | ')}
                         </div>`;
        }

        if (!justHtml) justHtml = '<span style="color:var(--text-muted); font-size: 0.8rem; font-weight: 500;">Sem observações</span>';

        trs += `<tr>
            <td>
              <div style="font-size:1rem; font-weight:800; margin-bottom: 10px; color:var(--text-main);">${d}</div>
              <span style="display:inline-block; font-size:0.7rem; padding:6px 12px; background: ${statusBg}; color: ${statusColor}; border-radius: 12px; font-weight: 800; letter-spacing: 0.5px;">${statusText}</span>
            </td>
            <td>
              <div style="margin-bottom: 6px;">
                 <span style="font-size:1.8rem; font-weight:800; color:var(--primary); line-height:1;">${inf.prod}</span> 
                 <span style="font-size:0.85rem; color:var(--text-muted); font-weight:700;">/ ${inf.meta} <span style="font-weight: 500;">(Meta)</span></span>
              </div>
              <div style="font-size:0.85rem; font-weight:800; color:${percColor};">${perc}% de Performance</div>
            </td>
            <td>${itemsText}</td>
            <td style="text-align:center;">
              <div style="font-size:1.4rem; font-weight:800; color:var(--primary); margin-bottom:4px;">${inf.intProd}</div>
              <div style="font-size:0.7rem; color:var(--text-muted); text-transform:uppercase; font-weight:700;">Produzindo</div>
            </td>
            <td>${justHtml}</td>
          </tr>`;
    });

    let avgProd = daysCount ? Math.round(totalProd / daysCount) : 0;
    let globalPerf = totalGlobalMeta > 0 ? Math.round((totalProd / totalGlobalMeta) * 100) : 0;
    if (totalGlobalMeta === 0 && totalProd > 0) globalPerf = 100;
    
    // Atualização dinâmica do Período no Header
    let rxHeaderPeriodo = document.getElementById('rxHeaderPeriodo');
    if (dateKeys.length > 0) {
        let dataInicio = dateKeys[0];
        let dataFim = dateKeys[dateKeys.length - 1];
        rxHeaderPeriodo.innerHTML = `<span class="material-icons" style="font-size: 16px; margin-right: 6px;">calendar_month</span> De ${dataInicio} até ${dataFim}`;
        rxHeaderPeriodo.style.display = 'flex';
    } else {
        rxHeaderPeriodo.style.display = 'none';
    }

    document.getElementById('rxTotalProd').innerText = totalProd;
    document.getElementById('rxPerfGeral').innerText = globalPerf + '%';
    document.getElementById('rxAvgProd').innerText = avgProd;
    document.getElementById('rxIntVinc').innerText = latestInt;

    document.getElementById('rxTableBody').innerHTML = trs || '<tr><td colspan="5" style="text-align:center; padding: 40px; color:var(--text-muted); font-weight: 600;">Nenhuma produção registrada neste período.</td></tr>';
    document.getElementById('rxDateSearch').value = '';

    // =================================================================
    // NOVO GRÁFICO (LINHAS: Sistema Azul, Planilha Laranja, Meta Vermelha)
    // =================================================================
    if (rxChartInst) rxChartInst.destroy();
    
    let pageOficina = document.getElementById('pageOficina');
    if (pageOficina && !pageOficina.classList.contains('active')) return;

    let prodPlanilhaData = dateKeys.map(d => {
        let itemsDia = rxGlobalDaysMap[d].items;
        let planRecs = itemsDia.filter(x => x.isPlanilha);
        if(planRecs.length > 0) return planRecs.reduce((a,b) => a + (b.producaoDia || 0), 0);
        return null;
    });

    let prodSistemaData = dateKeys.map(d => {
        let itemsDia = rxGlobalDaysMap[d].items;
        let sysRecs = itemsDia.filter(x => !x.isPlanilha);
        if(sysRecs.length > 0) return sysRecs.reduce((a,b) => a + (b.producaoDia || 0), 0);
        return null;
    });

    let metaData = dateKeys.map(d => {
        let itemsDia = rxGlobalDaysMap[d].items;
        let allInsumo = itemsDia.length > 0 && itemsDia.every(r => r.producaoDia === 0 && safeIsSemInsumo(r.justificativa));
        if (allInsumo) return 0;
        let valid = itemsDia.filter(r => !(r.producaoDia === 0 && safeIsSemInsumo(r.justificativa)));
        if (valid.length > 0 && typeof calculateDynamicMeta === 'function') return calculateDynamicMeta(valid);
        return refMeta;
    });

    const isDark = document.body.classList.contains('dark-mode');
    const gridColor = isDark ? '#37474f' : '#e2e8f0';
    const textColor = isDark ? '#a0abb5' : '#64748b';
    let ctx = document.getElementById('rxChart').getContext('2d');

    rxChartInst = new Chart(ctx, {
        type: 'line',
        data: {
            labels: dateKeys,
            datasets: [
                {
                    label: 'Produção (Novo Sistema)', 
                    data: prodSistemaData, 
                    spanGaps: true, 
                    borderColor: '#1E88E5', 
                    backgroundColor: '#1E88E5',
                    borderWidth: 3, 
                    pointRadius: 5, 
                    pointBackgroundColor: isDark ? '#1c2126' : '#ffffff', 
                    tension: 0.2
                },
                {
                    label: 'Produção (Histórico da Planilha)', 
                    data: prodPlanilhaData, 
                    spanGaps: true, 
                    borderColor: '#F59E0B', 
                    backgroundColor: '#F59E0B',
                    borderWidth: 3, 
                    pointRadius: 5, 
                    pointBackgroundColor: isDark ? '#1c2126' : '#ffffff', 
                    tension: 0.2
                },
                {
                    label: 'Meta', 
                    data: metaData, 
                    spanGaps: true, 
                    borderColor: '#EF5350', 
                    borderWidth: 2, 
                    borderDash: [6,6], 
                    pointRadius: 0
                }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            layout: { padding: { top: 15 } },
            scales: {
                x: { grid: {display:false}, ticks: {color: textColor, font: {family: 'Poppins'}} },
                y: { beginAtZero: true, grid:{color: gridColor}, ticks: {color: textColor, font: {family: 'Poppins'}} }
            },
            plugins: { 
                legend: { display: false },
                datalabels: { display: false }, // Oculta datalabels (números) nas linhas para manter visual limpo
                tooltip: {
                    titleFont: {family: 'Poppins'}, bodyFont: {family: 'Poppins'},
                    callbacks: {
                        label: function(context) {
                            if(context.datasetIndex === 2) return `Meta: ${context.parsed.y}`;
                            let datasetLabel = context.dataset.label || '';
                            if (context.parsed.y !== null) return `${datasetLabel}: ${context.parsed.y}`;
                            return null;
                        },
                        afterBody: function(tooltipItems) {
                            if(tooltipItems[0].datasetIndex === 2) return []; 
                            
                            let idx = tooltipItems[0].dataIndex; 
                            let dateVal = dateKeys[idx];
                            let dayRecords = rxFilteredDataGlobal.filter(x => x.data === dateVal);
                            let totalProd = dayRecords.reduce((a, b) => a + (b.producaoDia || 0), 0);
                            let validRecords = dayRecords.filter(r => !(r.producaoDia === 0 && safeIsSemInsumo(r.justificativa)));
                            let dayMeta = (validRecords.length && typeof calculateDynamicMeta === 'function') ? calculateDynamicMeta(validRecords) : refMeta;
                            
                            let finalLines = [];
                            finalLines.push(`--- DETALHES DO DIA ---`);
                            
                            if (dayRecords.length > 0) {
                                let internosUsados = dayRecords[0].qtd_internos || dayRecords[0].internos || '?';
                                let maquinasUsadas = dayRecords[0].maquinas || '?';
                                finalLines.push(`• Máquinas: ${maquinasUsadas} | Internos: ${internosUsados}`);
                            }

                            if (totalProd > 0 && typeof wrapText === 'function') {
                                dayRecords.forEach(r => { 
                                    if (r.item !== 'Nenhum') {
                                        if (r.isPlanilha) {
                                            finalLines.push(...wrapText(`• ${r.producaoDia}x ${r.item} (Histórico da Planilha)`, 55)); 
                                        } else {
                                            let extra = [];
                                            if (r.tamanho) extra.push(`Tam: ${r.tamanho}`);
                                            if (r.processoNome && r.processoNome !== '-') extra.push(`Órgão: ${r.processoNome}`);
                                            let extraStr = extra.length > 0 ? ` [${extra.join(' | ')}]` : '';
                                            finalLines.push(...wrapText(`• ${r.producaoDia}x ${r.item} (${r.tipo || '-'})${extraStr}`, 55)); 
                                        }
                                    }
                                });
                            }

                            let justs = [...new Set(dayRecords.map(r => r.justificativa).filter(j => j && j.trim() !== ""))];
                            let obss = [...new Set(dayRecords.map(r => r.observacao).filter(o => o && o.trim() !== ""))];

                            if (totalProd < dayMeta) {
                                if (justs.length > 0 && typeof wrapText === 'function') {
                                    justs.forEach(j => { finalLines.push(...wrapText(`• Just.: ${j}`, 55)); }); 
                                } else {
                                    finalLines.push('• Just.: Não informada');
                                }
                            }

                            if (obss.length > 0 && typeof wrapText === 'function') {
                                obss.forEach(o => { finalLines.push(...wrapText(`• Obs: ${o}`, 55)); });
                            }

                            return finalLines;
                        }
                    }
                }
            }
        }
    });
}

// Escutador adicional para garantir que renderize quando a página se tornar visível no menu
const rxObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
        if (mutation.attributeName === "class") {
            if (document.getElementById('pageOficina').classList.contains('active')) {
                renderPageOficina();
            }
        }
    });
});
rxObserver.observe(document.getElementById('pageOficina'), { attributes: true });

</script>