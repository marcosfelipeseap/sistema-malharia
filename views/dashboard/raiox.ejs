        <div style="text-align: center; padding: 0 15px;">
          <div style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; opacity: 0.9; color: #90CAF9; margin-bottom: 4px;">Resumo Semanal</div>
          <div style="font-size: 1.6rem; font-weight: 800; line-height: 1; margin-bottom: 2px;" id="rxSemanaNum">--</div>
