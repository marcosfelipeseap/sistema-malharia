<!-- =========================================================
     PAGE 2 — RAIO X DA OFICINA
     ========================================================= -->
<div id="pageOficina" class="page">
  <style>
    .rx-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
    
    .rx-week-banner { background: linear-gradient(135deg, var(--primary), #0D47A1); color: white; border-radius: 20px; padding: 30px; margin-bottom: 30px; display: flex; flex-direction: column; gap: 20px; box-shadow: var(--shadow); }
    .rx-week-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; border-bottom: 1px solid rgba(255,255,255,0.2); padding-bottom: 20px; }
    
    .rx-week-nav-container { display: flex; align-items: center; gap: 15px; }
    .rx-week-nav-btn { background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: white; border-radius: 12px; padding: 10px; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; }
    .rx-week-nav-btn:hover { background: rgba(255,255,255,0.3); transform: scale(1.05); }
    
    .rx-week-stats { display: flex; gap: 15px; flex-wrap: wrap; }
    .rx-week-stat { display: flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.15); padding: 15px 25px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); }
    .rx-week-stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.9; font-weight: 700; margin-bottom: 5px; }
    .rx-week-stat-value { font-size: 1.8rem; font-weight: 800; line-height: 1; }
    
    .rx-week-days-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 15px; }
    .rx-day-card { background: rgba(0,0,0,0.2); border-radius: 12px; padding: 15px; font-size: 0.85rem; display: flex; flex-direction: column; gap: 10px; border: 1px solid rgba(255,255,255,0.1); transition: 0.2s; }
    .rx-day-card:hover { background: rgba(0,0,0,0.3); transform: translateY(-2px); }
    .rx-day-card.missing { opacity: 0.6; border-style: dashed; justify-content: center; align-items: center; text-align: center; }
    .rx-day-card.weekend { opacity: 0.4; } 
    .rx-day-header { display: flex; justify-content: space-between; align-items: center; font-weight: 800; font-size: 0.9rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px; text-transform: uppercase; }
    .rx-day-prod { display: flex; justify-content: space-between; align-items: center; }
    .rx-day-items { opacity: 0.9; line-height: 1.5; font-size: 0.8rem; font-weight: 500; }
    .rx-day-just { background: rgba(244, 67, 54, 0.25); padding: 8px 10px; border-radius: 8px; color: #FFCDD2; font-size: 0.75rem; border-left: 3px solid #EF5350; }
    
    body.dark-mode .rx-week-banner { background: linear-gradient(135deg, #1565C0, #001e3c); }

    .rx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .rx-card { background: var(--surface); padding: 25px 20px; border-radius: 20px; border: none; box-shadow: var(--shadow); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
    .rx-card-title { font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; margin-bottom: 10px; letter-spacing: 0.5px; }
    .rx-card-value { font-size: 2.2rem; font-weight: 800; color: var(--text-main); line-height: 1; }
    .rx-card-sub { font-size: 0.75rem; color: var(--text-muted); margin-top: 8px; font-weight: 500; }
    
    .rx-table-wrapper { background: var(--surface); border-radius: 20px; border: none; box-shadow: var(--shadow); overflow: hidden; margin-top: 25px; }
    .rx-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .rx-table th { background: var(--surface); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem; font-weight: 800; padding: 20px; text-align: left; border-bottom: 2px solid var(--border); }
    .rx-table td { padding: 20px; border-bottom: 1px dashed var(--border); color: var(--text-main); vertical-align: top; }
    .rx-table tr:last-child td { border-bottom: none; }
    .rx-table tr:hover td { background: var(--bg-body); }

    .rx-history-search { display: flex; justify-content: space-between; align-items: center; padding: 20px 25px; border-bottom: 1px solid var(--border); background: var(--surface); flex-wrap: wrap; gap: 15px; }
    .rx-history-search input { width: 350px; padding: 12px 15px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-body); color: var(--text-main); font-size: 0.9rem; outline: none; transition: 0.2s; font-family: inherit; font-weight: 500;}
    .rx-history-search input:focus { border-color: var(--primary); }

    .custom-dropdown { position: relative; width: 100%; user-select: none; }
    .custom-dropdown-btn { width: 100%; padding: 12px 16px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); color: var(--text-main); font-size: 0.95rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: 0.2s; font-weight: 600;}
    .custom-dropdown-btn:hover { border-color: var(--primary); }
    
    .custom-dropdown-content { display: none; position: absolute; top: 100%; left: 0; right: 0; margin-top: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); z-index: 100; max-height: 350px; flex-direction: column; overflow: hidden; }
    .custom-dropdown-search { padding: 12px; border-bottom: 1px solid var(--border); background: var(--surface); }
    .custom-dropdown-search input { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 0.9rem; outline: none; background: var(--bg-body); color: var(--text-main); font-family: inherit; font-weight: 500;}
    .custom-dropdown-search input:focus { border-color: var(--primary); }
    
    .custom-options-wrapper { overflow-y: auto; flex: 1; padding: 5px 0; }
    .custom-option { padding: 12px 20px; font-size: 0.9rem; cursor: pointer; color: var(--text-main); border-bottom: 1px dashed var(--border); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500;}
    .custom-option:last-child { border-bottom: none; }
    .custom-option:hover { background: var(--primary-light); color: var(--primary); font-weight: 700; }
  </style>

