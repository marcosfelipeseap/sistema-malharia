        </div>
        <div class="rx-week-stat">
          <div class="rx-week-stat-label">Meta</div>
          <div class="rx-week-stat-value" id="rxWeekMeta">0</div>
        </div>
        <div class="rx-week-stat">
          <div class="rx-week-stat-label">Performance</div>
