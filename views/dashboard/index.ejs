<!-- =========================================================
     PAINEL PÚBLICO — ARQUIVO MESTRE
     ========================================================= -->

<!-- BARRA DE FILTRO DE TEMPO GLOBAL (COMPARTILHADA ENTRE AS PÁGINAS) -->
<div class="top-bar" style="background: var(--surface); padding: 20px 25px; border-radius: 20px; box-shadow: var(--shadow); margin-bottom: 30px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
    <div>
      <span style="font-weight: 800; font-size: 1.15rem; display: block; color: var(--text-main); text-transform: uppercase;">Filtro de Período Geral</span>
      <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 500;">Define o intervalo de datas para os relatórios, gráficos, demandas e processos.</span>
    </div>
    
    <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap; width: 100%; max-width: 500px;">
      <div class="filter-group" style="flex: 1; min-width: 130px;">
        <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 5px;">Data Inicial</label>
        <input type="date" id="globalStartFilter" onchange="triggerGlobalFilter()" style="width: 100%;">
      </div>
      <div class="filter-group" style="flex: 1; min-width: 130px;">
        <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 5px;">Data Final</label>
        <input type="date" id="globalEndFilter" onchange="triggerGlobalFilter()" style="width: 100%;">
      </div>
      <div style="display: flex; align-items: flex-end; padding-bottom: 2px;">
        <button class="btn-notif btn-notif-sec" onclick="resetGlobalFilter()" style="height: 44px; padding: 0 15px;">LIMPAR</button>
      </div>
    </div>
  </div>
</div>

<script>
    // INJEÇÃO SEGURA DAS VARIÁVEIS VINDAS DO CONTROLLER
    const rawData = <%- typeof rawDataJSON !== 'undefined' ? rawDataJSON : '[]' %>;
    const feriadosData = <%- typeof feriadosJSON !== 'undefined' ? feriadosJSON : '[]' %>;
    const demandasData = <%- typeof demandasJSON !== 'undefined' ? demandasJSON : '[]' %>;
    const processosData = <%- typeof processosJSON !== 'undefined' ? processosJSON : '[]' %>;
    const scheduleData = <%- typeof scheduleJSON !== 'undefined' ? scheduleJSON : '[]' %>;
    const rankingOficialData = <%- typeof rankingJSON !== 'undefined' ? rankingJSON : '[]' %>;
    window.infoOficinasEstatico = <%- typeof infoOficinasEstaticoJSON !== 'undefined' ? infoOficinasEstaticoJSON : '[]' %>;
    
    // Dados de Fardamento originários da Planilha Google
    const fardamentoData = <%- typeof fardamentoJSON !== 'undefined' ? fardamentoJSON : '[]' %>;
    const fardamentoSeapData = <%- typeof fardamentoseapJSON !== 'undefined' ? fardamentoseapJSON : '[]' %>;

    // Normalização inicial das datas dos registros de produção
    rawData.forEach(r => {
        if(typeof r.dateObj === 'string') r.dateObj = new Date(r.dateObj);
    });

    let selectedOficinas = [];
    let activeCharts = [];
    let chartDemandaInst = null;
    let globalDemandas = [];
    const daysOfWeek = ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'];

    // Funções utilitárias globais
    function isSemInsumo(just) {
        if (!just) return false;
        let txt = just.toLowerCase();
        return txt.includes('insumo') && (txt.includes('sem') || txt.includes('falta'));
    }

    function isDateWeekend(dateStr) {
        if (!dateStr) return false;
        let p = dateStr.split('/');
        if (p.length !== 3) return false;
        let day = new Date(p[2], p[1] - 1, p[0]).getDay();
        return day === 0 || day === 6;
    }

    function isFeriado(dateStr, oficinaName) {
        return feriadosData.some(f => f.data === dateStr && (f.oficina === 'Todas' || f.oficina === oficinaName));
    }

    // Gerenciador do Filtro de Tempo Dinâmico Global
    function getFilterDates() {
        let startInput = document.getElementById('globalStartFilter').value;
        let endInput = document.getElementById('globalEndFilter').value;

        let start = startInput ? new Date(startInput + 'T00:00:00') : new Date(2020, 0, 1);
        let end = endInput ? new Date(endInput + 'T23:59:59') : new Date(2100, 11, 31);

        return { start, end };
    }

    function triggerGlobalFilter() {
        if (document.getElementById('pageOficina') && document.getElementById('pageOficina').classList.contains('active')) {
            if (typeof renderPageOficina === 'function') renderPageOficina();
        }
        if (document.getElementById('page2') && document.getElementById('page2').classList.contains('active')) {
            if (typeof setupChips === 'function') setupChips();
        }
        if (document.getElementById('page3') && document.getElementById('page3').classList.contains('active')) {
            if (typeof renderPage3 === 'function') renderPage3();
        }
        if (document.getElementById('page4') && document.getElementById('page4').classList.contains('active')) {
            if (typeof setupDemanda === 'function') setupDemanda();
        }
        if (document.getElementById('page5') && document.getElementById('page5').classList.contains('active')) {
            if (typeof initProcesses === 'function') initProcesses(processosData);
        }
        if (document.getElementById('page6') && document.getElementById('page6').classList.contains('active')) {
            if (typeof initCronograma === 'function') initCronograma();
        }
        if (document.getElementById('pageApresentacao') && document.getElementById('pageApresentacao').classList.contains('active')) {
            if (typeof renderPageApresentacao === 'function') renderPageApresentacao();
        }
    }

    function resetGlobalFilter() {
        document.getElementById('globalStartFilter').value = '';
        document.getElementById('globalEndFilter').value = '';
        triggerGlobalFilter();
    }

    // Funções de Cálculo Estáticas
    function calculateDynamicMeta(dayRecords) {
        if (!dayRecords || dayRecords.length === 0) return 0;
        if (dayRecords.length === 1) return dayRecords[0].metaOficina || 0;

        let maxMeta = Math.max(...dayRecords.map(r => r.metaOficina || 0));
        let effectiveMetas = dayRecords.map(r => (r.metaOficina || 0) === 0 ? maxMeta : (r.metaOficina || 0));

        let maxProd = -1;
        let metaDoMaisProduzido = 0;
        let reached25 = false;

        dayRecords.forEach((r, idx) => {
            let m = effectiveMetas[idx];
            if (r.producaoDia > maxProd) {
                maxProd = r.producaoDia;
                metaDoMaisProduzido = m;
            }
            if (r.producaoDia >= (0.25 * m)) {
                reached25 = true;
            }
        });

        if (reached25) {
            let sum = effectiveMetas.reduce((a, b) => a + b, 0);
            return Math.round(sum / effectiveMetas.length);
        } else {
            return metaDoMaisProduzido;
        }
    }

    function getMissingBusinessDaysCustom(oficina, allData) {
        let datesFilter = getFilterDates();
        let oficinaRecords = allData.filter(r => r.oficina === oficina && r.dateObj >= datesFilter.start && r.dateObj <= datesFilter.end);
        if (oficinaRecords.length === 0) return [];

        let minDate = new Date(Math.min(...oficinaRecords.map(r => r.dateObj.getTime())));
        if (minDate < datesFilter.start) minDate = datesFilter.start;

        let presentDates = new Set(oficinaRecords.map(r => r.data));
        let missing = [];
        let curr = new Date(minDate);
        let now = new Date();
        if (datesFilter.end < now) now = datesFilter.end;
        if (curr > now) return [];

        let maxRegObj = oficinaRecords.reduce((max, r) => r.dateObj > max ? r.dateObj : max, new Date(0));

        while (curr <= now) {
            let dayOfWeek = curr.getDay();
            if (dayOfWeek !== 0 && dayOfWeek !== 6) { 
                let dStr = String(curr.getDate()).padStart(2, '0') + '/' + String(curr.getMonth() + 1).padStart(2, '0') + '/' + curr.getFullYear();
                let inRecess = (curr.getTime() >= new Date(2025, 11, 23).getTime() && curr.getTime() <= new Date(2026, 0, 2).getTime());
                let isHoliday = isFeriado(dStr, oficina);
                let isAfterLastReg = (oficina === "GALPÃO 3.1" || oficina === "GALPÃO 3.2") && curr > maxRegObj;

                if (!presentDates.has(dStr) && !inRecess && !isHoliday && !isAfterLastReg) {
                    missing.push(`${dStr} (${daysOfWeek[dayOfWeek]})`);
                }
            }
            curr.setDate(curr.getDate() + 1);
        }
        return missing;
    }

    function getMissingBusinessDays(oficina, startDate, endDate, allData) {
        return getMissingBusinessDaysCustom(oficina, allData);
    }

    function wrapText(text, maxLen) {
        if (text.length <= maxLen) return [text];
        let words = text.split(' ');
        let lines = [];
        let currentLine = '';
        words.forEach(word => {
            if ((currentLine + word).length <= maxLen) {
                currentLine += (currentLine ? ' ' : '') + word;
            } else {
                lines.push(currentLine);
                currentLine = word;
            }
        });
        if (currentLine) lines.push(currentLine);
        return lines;
    }

    // Inicialização da Página Diária e Pré-carregamento dos Fardamentos
    document.addEventListener("DOMContentLoaded", () => {
        const hoje = new Date().toLocaleString("en-US", { timeZone: "America/Sao_Paulo" });
        const objHoje = new Date(hoje);
        const yyyy = objHoje.getFullYear();
        const mm = String(objHoje.getMonth() + 1).padStart(2, '0');
        const dd = String(objHoje.getDate()).padStart(2, '0');
        
        if (document.getElementById('dailyDate')) {
            document.getElementById('dailyDate').value = `${yyyy}-${mm}-${dd}`;
            if (typeof renderPage1 === 'function') renderPage1();
        }

        // PRELOAD DOS DADOS DA PLANILHA
        if (typeof preloadFardamento === 'function') preloadFardamento(fardamentoData);
        if (typeof preloadFardamentoSeap === 'function') preloadFardamentoSeap(fardamentoSeapData);
    });
</script>

