<script>
  let chartInstItensApresSis = null;
  let chartInstMesApresSis = null;

  function mudarFiltroMesApresentacao() {
    const mesVal = document.getElementById('apresFiltroMes').value;
    if (mesVal) {
      const [ano, mes] = mesVal.split('-');
      const primeiroDia = `${ano}-${mes}-01`;
      const ultimoDia = new Date(ano, mes, 0).toISOString().split('T')[0];
      
      document.getElementById('apresFiltroInicio').value = primeiroDia;
      document.getElementById('apresFiltroFim').value = ultimoDia;
      renderPageApresentacao();
    }
  }

  function limparMesSePersonalizado() {
    document.getElementById('apresFiltroMes').value = '';
    renderPageApresentacao();
  }

  function aplicarFiltroApresentacao() {
    renderPageApresentacao();
  }

  function formatarDataSimples(dateObj) {
    if (!dateObj || isNaN(dateObj.getTime())) return '-';
    return dateObj.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function renderPageApresentacao() {
    const pageEl = document.getElementById('pageApresentacao');
    if (!pageEl || !pageEl.classList.contains('active')) return;

    // Filtros Globais e Específicos
    const globalDates = getFilterDates();
    let startInput = document.getElementById('apresFiltroInicio').value;
    let endInput = document.getElementById('apresFiltroFim').value;
    let customStartDate = startInput ? new Date(startInput + 'T00:00:00') : new Date(2020, 0, 1);
    let customEndDate = endInput ? new Date(endInput + 'T23:59:59') : new Date(2100, 11, 31);

    // Variáveis SISTEMA
    let mapaGeralItensSis = {};
    let mapaGeralMesSis = {}; 
    let mapaOficinasGeralSis = {};
    let totalGeralQtdSis = 0;
    let minDateSis = new Date(8640000000000000);
    let maxDateSis = new Date(-8640000000000000);

    // Variáveis PLANILHA
    let mapaGeralItensAnt = {};
    let mapaGeralMesAnt = {}; 
    let mapaOficinasGeralAnt = {};
    let totalGeralQtdAnt = 0;
    let minDateAnt = new Date(8640000000000000);
    let maxDateAnt = new Date(-8640000000000000);

    // Variáveis UNIFICADAS PARA O FILTRO RÁPIDO
    let mapaFiltradoItensUnificado = {};
    let totalFiltradoQtdUnificado = 0;
    let minDateUnificado = new Date(8640000000000000);
    let maxDateUnificado = new Date(-8640000000000000);

    // Processar DADOS SISTEMA (rawData)
    if (typeof rawData !== 'undefined') {
      rawData.forEach(r => {
        const qtd = r.producaoDia || 0;
        if (!r.item || r.item === 'Nenhum' || qtd <= 0) return;

        const nomeItem = r.item.trim();
        const nomeOficina = r.oficina || 'Geral';

        if (r.dateObj >= globalDates.start && r.dateObj <= globalDates.end) {
          if (r.dateObj < minDateSis) minDateSis = r.dateObj;
          if (r.dateObj > maxDateSis) maxDateSis = r.dateObj;

          if (!mapaGeralItensSis[nomeItem]) mapaGeralItensSis[nomeItem] = { item: nomeItem, qtd: 0 };
          mapaGeralItensSis[nomeItem].qtd += qtd;
          totalGeralQtdSis += qtd;

          if (!mapaOficinasGeralSis[nomeOficina]) mapaOficinasGeralSis[nomeOficina] = 0;
          mapaOficinasGeralSis[nomeOficina] += qtd;

          if (r.dataOriginal) {
            const anoMes = r.dataOriginal.substring(0, 7); 
            if (!mapaGeralMesSis[anoMes]) mapaGeralMesSis[anoMes] = { anoMes, qtd: 0 };
            mapaGeralMesSis[anoMes].qtd += qtd;
          }
        }

        // Adiciona ao Bloco Unificado
        if (r.dateObj >= customStartDate && r.dateObj <= customEndDate) {
          if (r.dateObj < minDateUnificado) minDateUnificado = r.dateObj;
          if (r.dateObj > maxDateUnificado) maxDateUnificado = r.dateObj;

          if (!mapaFiltradoItensUnificado[nomeItem]) mapaFiltradoItensUnificado[nomeItem] = { item: nomeItem, qtd: 0 };
          mapaFiltradoItensUnificado[nomeItem].qtd += qtd;
          totalFiltradoQtdUnificado += qtd;
        }
      });
    }

    // Processar DADOS PLANILHA (dadosAntigos)
    if (typeof dadosAntigos !== 'undefined') {
      dadosAntigos.forEach(r => {
        const qtd = r.producaoDia || 0;
        if (!r.item || qtd <= 0) return;
        
        const nomeItem = r.item.trim();
        const nomeOficina = r.oficina || 'Geral';

        if (r.dateObj >= globalDates.start && r.dateObj <= globalDates.end) {
          if (r.dateObj < minDateAnt) minDateAnt = r.dateObj;
          if (r.dateObj > maxDateAnt) maxDateAnt = r.dateObj;

          if (!mapaGeralItensAnt[nomeItem]) mapaGeralItensAnt[nomeItem] = { item: nomeItem, qtd: 0 };
          mapaGeralItensAnt[nomeItem].qtd += qtd;
          totalGeralQtdAnt += qtd;

          if (!mapaOficinasGeralAnt[nomeOficina]) mapaOficinasGeralAnt[nomeOficina] = 0;
          mapaOficinasGeralAnt[nomeOficina] += qtd;

          if (r.dataOriginal) {
            const anoMes = r.dataOriginal.substring(0, 7); 
            if (!mapaGeralMesAnt[anoMes]) mapaGeralMesAnt[anoMes] = { anoMes, qtd: 0 };
            mapaGeralMesAnt[anoMes].qtd += qtd;
          }
        }

        // Adiciona ao Bloco Unificado
        if (r.dateObj >= customStartDate && r.dateObj <= customEndDate) {
          if (r.dateObj < minDateUnificado) minDateUnificado = r.dateObj;
          if (r.dateObj > maxDateUnificado) maxDateUnificado = r.dateObj;

          if (!mapaFiltradoItensUnificado[nomeItem]) mapaFiltradoItensUnificado[nomeItem] = { item: nomeItem, qtd: 0 };
          mapaFiltradoItensUnificado[nomeItem].qtd += qtd;
          totalFiltradoQtdUnificado += qtd;
        }
      });
    }

    // ==========================================
    // ATUALIZAR UI - SISTEMA
    // ==========================================
    if (totalGeralQtdSis > 0) {
      document.getElementById('lblPeriodoSistema').innerText = `Período extraído: a partir de ${formatarDataSimples(minDateSis)} até ${formatarDataSimples(maxDateSis)}`;
    } else {
      document.getElementById('lblPeriodoSistema').innerText = `Nenhum dado do sistema encontrado no filtro atual.`;
    }

    document.getElementById('apresTotalGeralSis').innerText = totalGeralQtdSis.toLocaleString('pt-BR');

    let tbodyGeralSis = document.getElementById('tabelaGeralItensSis');
    tbodyGeralSis.innerHTML = '';
    const itensGeralOrdenadosSis = Object.values(mapaGeralItensSis).sort((a, b) => b.qtd - a.qtd);
    
    if (itensGeralOrdenadosSis.length === 0) {
      tbodyGeralSis.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhum registro.</td></tr>`;
    } else {
      itensGeralOrdenadosSis.forEach(i => {
        tbodyGeralSis.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${i.item}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: var(--primary);">${i.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    let tbodyMesSis = document.getElementById('tabelaMediaMesSis');
    tbodyMesSis.innerHTML = '';
    const mesesArraySis = Object.values(mapaGeralMesSis).sort((a, b) => b.anoMes.localeCompare(a.anoMes));
    
    if (mesesArraySis.length === 0) {
      tbodyMesSis.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Sem dados mensais.</td></tr>`;
    } else {
      let totalMesesUnicosSis = mesesArraySis.length || 1;
      document.getElementById('apresMediaMensalGeralSis').innerText = Math.round(totalGeralQtdSis / totalMesesUnicosSis).toLocaleString('pt-BR');

      mesesArraySis.slice(0, 10).forEach(m => {
        const dateStr = new Date(m.anoMes + '-01T00:00:00').toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
        const formatadoBonito = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
        tbodyMesSis.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600; text-transform: capitalize;">${formatadoBonito}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #3B82F6;">${m.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    let tbodyOficinasSis = document.getElementById('tabelaOficinasGeralSis');
    tbodyOficinasSis.innerHTML = '';
    const oficinasOrdenadasSis = Object.entries(mapaOficinasGeralSis).sort((a, b) => b[1] - a[1]);

    if (oficinasOrdenadasSis.length === 0) {
      tbodyOficinasSis.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhuma unidade.</td></tr>`;
    } else {
      oficinasOrdenadasSis.forEach(([nomeOficina, qtdOficina]) => {
        tbodyOficinasSis.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${nomeOficina}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #8B5CF6;">${qtdOficina.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    renderizarGraficosApresSis(itensGeralOrdenadosSis, mesesArraySis.reverse());

    // ==========================================
    // ATUALIZAR UI - PLANILHA ANTIGA
    // ==========================================
    if (totalGeralQtdAnt > 0) {
      document.getElementById('lblPeriodoPlanilha').innerText = `Período extraído: de ${formatarDataSimples(minDateAnt)} a ${formatarDataSimples(maxDateAnt)}`;
    } else {
      document.getElementById('lblPeriodoPlanilha').innerText = `Nenhum dado histórico encontrado na planilha neste filtro.`;
    }

    document.getElementById('apresTotalGeralAnt').innerText = totalGeralQtdAnt.toLocaleString('pt-BR');

    let tbodyItensAnt = document.getElementById('tabelaGeralItensAnt');
    tbodyItensAnt.innerHTML = '';
    const itensAntOrdenados = Object.values(mapaGeralItensAnt).sort((a, b) => b.qtd - a.qtd);
    
    if (itensAntOrdenados.length === 0) {
      tbodyItensAnt.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhum registro.</td></tr>`;
    } else {
      itensAntOrdenados.forEach(i => {
        tbodyItensAnt.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${i.item}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #F59E0B;">${i.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    let tbodyMesAnt = document.getElementById('tabelaMediaMesAnt');
    tbodyMesAnt.innerHTML = '';
    const mesesArrayAnt = Object.values(mapaGeralMesAnt).sort((a, b) => b.anoMes.localeCompare(a.anoMes));
    
    if (mesesArrayAnt.length === 0) {
      tbodyMesAnt.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Sem dados mensais.</td></tr>`;
    } else {
      let totalMesesUnicosAnt = mesesArrayAnt.length || 1;
      document.getElementById('apresMediaMensalGeralAnt').innerText = Math.round(totalGeralQtdAnt / totalMesesUnicosAnt).toLocaleString('pt-BR');

      mesesArrayAnt.forEach(m => {
        const dateStr = new Date(m.anoMes + '-01T00:00:00').toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
        const formatadoBonito = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);
        tbodyMesAnt.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600; text-transform: capitalize;">${formatadoBonito}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #10B981;">${m.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    let tbodyOficinasAnt = document.getElementById('tabelaOficinasGeralAnt');
    tbodyOficinasAnt.innerHTML = '';
    const oficinasOrdenadasAnt = Object.entries(mapaOficinasGeralAnt).sort((a, b) => b[1] - a[1]);

    if (oficinasOrdenadasAnt.length === 0) {
      tbodyOficinasAnt.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhuma unidade.</td></tr>`;
    } else {
      oficinasOrdenadasAnt.forEach(([nomeOficina, qtdOficina]) => {
        tbodyOficinasAnt.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${nomeOficina}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #8B5CF6;">${qtdOficina.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    // ==========================================
    // ATUALIZAR UI - FILTRO RÁPIDO UNIFICADO
    // ==========================================
    if (totalFiltradoQtdUnificado > 0) {
      document.getElementById('lblPeriodoFiltroRapido').innerText = `Período analisado: de ${formatarDataSimples(minDateUnificado)} a ${formatarDataSimples(maxDateUnificado)}`;
    } else {
      document.getElementById('lblPeriodoFiltroRapido').innerText = `Nenhum dado encontrado no período selecionado.`;
    }

    document.getElementById('apresTotalFiltrado').innerText = totalFiltradoQtdUnificado.toLocaleString('pt-BR') + ' peças';

    let tbodyFiltro = document.getElementById('tabelaFiltroPersonalizado');
    tbodyFiltro.innerHTML = '';
    const itensFiltradosUnificados = Object.values(mapaFiltradoItensUnificado).sort((a, b) => b.qtd - a.qtd);

    if (itensFiltradosUnificados.length === 0) {
      tbodyFiltro.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhum dado encontrado no período selecionado.</td></tr>`;
    } else {
      itensFiltradosUnificados.forEach(i => {
        tbodyFiltro.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${i.item}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #10B981;">${i.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }
  }

  function renderizarGraficosApresSis(itensArr, mesesArr) {
    const isDark = document.body.classList.contains('dark-mode');
    const gridColor = isDark ? '#37474f' : '#e2e8f0';
    const textColor = isDark ? '#a0abb5' : '#64748b';

    const ctxItens = document.getElementById('graficoItensApresSis').getContext('2d');
    if (chartInstItensApresSis) chartInstItensApresSis.destroy();

    chartInstItensApresSis = new Chart(ctxItens, {
      type: 'bar',
      data: {
        labels: itensArr.map(i => i.item),
        datasets: [{
          label: 'Peças Produzidas',
          data: itensArr.map(i => i.qtd),
          backgroundColor: '#001E7A',
          borderRadius: 8
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false, layout: { padding: { top: 35 } },
        plugins: {
          legend: { display: false },
          datalabels: { anchor: 'end', align: 'top', color: textColor, font: { weight: 'bold', size: 11, family: 'Poppins' }, formatter: (value) => value.toLocaleString('pt-BR') }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: gridColor }, ticks: { font: { size: 11, family: 'Poppins' }, color: textColor } },
          x: { grid: { display: false }, ticks: { font: { size: 10, family: 'Poppins' }, maxRotation: 45, minRotation: 45, color: textColor } }
        }
      },
      plugins: [ChartDataLabels]
    });

    const ctxMes = document.getElementById('graficoMesApresSis').getContext('2d');
    if (chartInstMesApresSis) chartInstMesApresSis.destroy();

    chartInstMesApresSis = new Chart(ctxMes, {
      type: 'line',
      data: {
        labels: mesesArr.map(m => {
          let partes = m.anoMes.split('-');
          return `${partes[1]}/${partes[0]}`;
        }),
        datasets: [{
          label: 'Peças no Mês',
          data: mesesArr.map(m => m.qtd),
          borderColor: '#3B82F6',
          backgroundColor: 'rgba(59, 130, 246, 0.15)',
          fill: true, tension: 0.3, pointRadius: 6, pointBackgroundColor: '#3B82F6'
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false, layout: { padding: { top: 35 } },
        plugins: {
          legend: { display: false },
          datalabels: { align: 'top', color: textColor, font: { weight: 'bold', size: 11, family: 'Poppins' }, formatter: (value) => value.toLocaleString('pt-BR') }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: gridColor }, ticks: { font: { size: 11, family: 'Poppins' }, color: textColor } },
          x: { grid: { display: false }, ticks: { font: { size: 11, family: 'Poppins' }, color: textColor } }
        }
      },
      plugins: [ChartDataLabels]
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    if (typeof renderPageApres === 'undefined') {
      window.renderPageApres = renderPageApresentacao;
    }
    renderPageApresentacao();
  });
</script>