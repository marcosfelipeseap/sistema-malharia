<!-- =========================================================
     PÁGINA: APRESENTAÇÃO (INTEGRADA AO FILTRO GERAL)
     ========================================================= -->
<div id="pageApresentacao" class="page active" style="display: block;">
  
  <!-- Cabeçalho Executivo -->
  <div style="background: linear-gradient(135deg, var(--primary), #0D47A1); color: white; padding: 35px 30px; border-radius: 20px; margin-bottom: 30px; box-shadow: var(--shadow);">
    <h2 style="font-size: 1.6rem; font-weight: 800; margin: 0 0 10px 0; color: white; text-transform: uppercase;">Painel Geral de Produção</h2>
    <p style="font-size: 0.95rem; margin: 0; opacity: 0.9; font-weight: 500;">Acompanhe o volume total de peças fabricadas, médias mensais, gráficos de desempenho detalhados e a produção por unidades baseado no filtro geral.</p>
  </div>

  <!-- Cards de Resumo Principal (Foco em Peças) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px; margin-bottom: 30px;">
    
    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow); border-left: 6px solid var(--primary);">
      <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; letter-spacing: 0.5px;">Total no Período Geral</span>
      <h3 id="apresTotalGeral" style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin: 10px 0 5px 0; line-height: 1;">0</h3>
      <span style="font-size: 0.85rem; font-weight: 600; color: var(--primary); display: block;">peças fabricadas no período</span>
    </div>

    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow); border-left: 6px solid #3B82F6;">
      <span style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; letter-spacing: 0.5px;">Média Mensal</span>
      <h3 id="apresMediaMensalGeral" style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin: 10px 0 5px 0; line-height: 1;">0</h3>
      <span style="font-size: 0.85rem; font-weight: 600; color: #3B82F6; display: block;">média de peças por mês</span>
    </div>

  </div>

  <!-- Gráficos Visuais Explicativos -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 25px; margin-bottom: 30px;">
    
    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow);">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin-bottom: 20px; text-transform: uppercase;">📊 Comparativo de Peças por Item</h3>
      <div style="position: relative; height: 320px; width: 100%;">
        <canvas id="graficoItensApres"></canvas>
      </div>
    </div>

    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow);">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin-bottom: 20px; text-transform: uppercase;">📈 Evolução Mensal de Peças</h3>
      <div style="position: relative; height: 320px; width: 100%;">
        <canvas id="graficoMesApres"></canvas>
      </div>
    </div>

  </div>

  <!-- Grade de Tabelas Executivas (Itens, Média Mensal e Unidades) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; margin-bottom: 25px;">
    
    <!-- Bloco 1: Total de Peças por Item -->
    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow);">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin-bottom: 5px; display: flex; align-items: center; gap: 8px; text-transform: uppercase;">
        <span class="material-icons" style="color: var(--primary); font-size: 22px;">inventory_2</span> 
        Total de Peças por Item
      </h3>
      <p style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted); margin-bottom: 15px;">Soma de todas as peças produzidas de cada produto.</p>
      
      <div style="overflow-x: auto; max-height: 280px; overflow-y: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); color: var(--text-muted); position: sticky; top: 0; background: var(--surface); text-transform: uppercase; font-size: 0.75rem;">
              <th style="padding: 12px 10px;">Item</th>
              <th style="padding: 12px 10px; text-align: right;">Quantidade</th>
            </tr>
          </thead>
          <tbody id="tabelaGeralItens">
            <!-- Preenchido via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Bloco 2: Média por Mês -->
    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow);">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin-bottom: 5px; display: flex; align-items: center; gap: 8px; text-transform: uppercase;">
        <span class="material-icons" style="color: #3B82F6; font-size: 22px;">calendar_today</span> 
        Histórico de Peças por Mês
      </h3>
      <p style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted); margin-bottom: 15px;">Volume de peças entregues mês a mês.</p>
      
      <div style="overflow-x: auto; max-height: 280px; overflow-y: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); color: var(--text-muted); position: sticky; top: 0; background: var(--surface); text-transform: uppercase; font-size: 0.75rem;">
              <th style="padding: 12px 10px;">Mês / Ano</th>
              <th style="padding: 12px 10px; text-align: right;">Quantidade</th>
            </tr>
          </thead>
          <tbody id="tabelaMediaMes">
            <!-- Preenchido via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Bloco 3: Produção por Unidades / Oficinas -->
    <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow);">
      <h3 style="font-size: 1rem; font-weight: 800; color: var(--text-main); margin-bottom: 5px; display: flex; align-items: center; gap: 8px; text-transform: uppercase;">
        <span class="material-icons" style="color: #8B5CF6; font-size: 22px;">store</span> 
        Produção por Unidades
      </h3>
      <p style="font-size: 0.8rem; font-weight: 500; color: var(--text-muted); margin-bottom: 15px;">Total de peças fabricadas em cada unidade.</p>
      
      <div style="overflow-x: auto; max-height: 280px; overflow-y: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); color: var(--text-muted); position: sticky; top: 0; background: var(--surface); text-transform: uppercase; font-size: 0.75rem;">
              <th style="padding: 12px 10px;">Unidade / Oficina</th>
              <th style="padding: 12px 10px; text-align: right;">Quantidade</th>
            </tr>
          </thead>
          <tbody id="tabelaOficinasGeral">
            <!-- Preenchido via JS -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Bloco 4: Produção no Período Selecionado (Com Filtro Próprio e Total Embaixo) -->
  <div style="background: var(--surface); padding: 25px; border-radius: 20px; box-shadow: var(--shadow); margin-top: 25px;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 20px;">
      <div>
        <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0 0 4px 0; display: flex; align-items: center; gap: 8px; text-transform: uppercase;">
          <span class="material-icons" style="color: #10B981; font-size: 22px;">filter_alt</span> 
          Produção no Período Selecionado
        </h3>
        <p style="font-size: 0.85rem; font-weight: 500; color: var(--text-muted); margin: 0;">Selecione um mês específico ou defina um intervalo de datas para esta análise específica.</p>
      </div>

      <!-- Controles de Filtro Interno -->
      <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
        <div>
          <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 5px;">Mês Específico</label>
          <input type="month" id="apresFiltroMes" onchange="mudarFiltroMesApresentacao()">
        </div>
        <div>
          <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 5px;">Data Inicial</label>
          <input type="date" id="apresFiltroInicio" onchange="limparMesSePersonalizado()">
        </div>
        <div>
          <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 5px;">Data Final</label>
          <input type="date" id="apresFiltroFim" onchange="limparMesSePersonalizado()">
        </div>
        <div style="align-self: flex-end; padding-bottom: 2px;">
          <button class="btn-notif btn-notif-pri" onclick="aplicarFiltroApresentacao()" style="height: 44px; padding: 0 20px;">Filtrar</button>
        </div>
      </div>
    </div>
    
    <div style="overflow-x: auto; margin-bottom: 20px;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
        <thead>
          <tr style="border-bottom: 2px solid var(--border); color: var(--text-muted); text-transform: uppercase; font-size: 0.75rem;">
            <th style="padding: 12px 10px;">Item</th>
            <th style="padding: 12px 10px; text-align: right;">Quantidade</th>
          </tr>
        </thead>
        <tbody id="tabelaFiltroPersonalizado">
          <!-- Preenchido via JS -->
        </tbody>
      </table>
    </div>

    <!-- TOTAL NO PERÍODO SELECIONADO MAIS EMBAIXO -->
    <div style="background: var(--input-bg, var(--bg-body)); padding: 20px 25px; border-radius: 16px; display: flex; justify-content: space-between; align-items: center; border: 1px dashed var(--border);">
      <span style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); text-transform: uppercase;">Total de Peças no Período Selecionado:</span>
      <h3 id="apresTotalFiltrado" style="font-size: 1.8rem; font-weight: 900; color: #10B981; margin: 0;">0 peças</h3>
    </div>

  </div>

</div>

<script>
  let chartInstItensApres = null;
  let chartInstMesApres = null;

  function mudarFiltroMesApresentacao() {
    const mesVal = document.getElementById('apresFiltroMes').value;
    if (mesVal) {
      const [ano, mes] = mesVal.split('-');
      const primeiroDia = `${ano}-${mes}-01`;
      const ultimoDia = new Date(ano, mes, 0).toISOString().split('T')[0];
      
      document.getElementById('apresFiltroInicio').value = primeiroDia;
      document.getElementById('apresFiltroFim').value = ultimoDia;
      renderPageApresentacao();
    }
  }

  function limparMesSePersonalizado() {
    document.getElementById('apresFiltroMes').value = '';
    renderPageApresentacao();
  }

  function aplicarFiltroApresentacao() {
    renderPageApresentacao();
  }

  function renderPageApresentacao() {
    const pageEl = document.getElementById('pageApresentacao');
    if (!pageEl || !pageEl.classList.contains('active')) return;

    // 1. Pega o Filtro Geral do Topo para o painel principal
    const globalDates = getFilterDates(); // { start, end }

    // 2. Pega o Filtro Próprio para o último bloco
    let startInput = document.getElementById('apresFiltroInicio').value;
    let endInput = document.getElementById('apresFiltroFim').value;
    let customStartDate = startInput ? new Date(startInput + 'T00:00:00') : new Date(2020, 0, 1);
    let customEndDate = endInput ? new Date(endInput + 'T23:59:59') : new Date(2100, 11, 31);

    let mapaGeralItens = {};
    let mapaGeralMes = {}; 
    let mapaFiltradoItens = {};
    let mapaOficinasGeral = {};

    let totalGeralQtd = 0;
    let totalFiltradoQtd = 0;

    rawData.forEach(r => {
      const qtd = r.producaoDia || 0;
      if (!r.item || r.item === 'Nenhum' || qtd <= 0) return;

      const nomeItem = r.item.trim();
      const nomeOficina = r.oficina || 'Geral';

      // Verifica se está dentro do Filtro Geral do Topo
      const dentroFiltroGeral = r.dateObj >= globalDates.start && r.dateObj <= globalDates.end;

      if (dentroFiltroGeral) {
        // Acumula para o painel geral superior, gráficos, itens e oficinas
        if (!mapaGeralItens[nomeItem]) {
          mapaGeralItens[nomeItem] = { item: nomeItem, qtd: 0 };
        }
        mapaGeralItens[nomeItem].qtd += qtd;
        totalGeralQtd += qtd;

        if (!mapaOficinasGeral[nomeOficina]) {
          mapaOficinasGeral[nomeOficina] = 0;
        }
        mapaOficinasGeral[nomeOficina] += qtd;

        if (r.dataOriginal) {
          const anoMes = r.dataOriginal.substring(0, 7); 
          if (!mapaGeralMes[anoMes]) {
            mapaGeralMes[anoMes] = { anoMes, qtd: 0 };
          }
          mapaGeralMes[anoMes].qtd += qtd;
        }
      }

      // Bloco Inferior: Usa o Filtro Próprio
      if (r.dateObj >= customStartDate && r.dateObj <= customEndDate) {
        if (!mapaFiltradoItens[nomeItem]) {
          mapaFiltradoItens[nomeItem] = { item: nomeItem, qtd: 0 };
        }
        mapaFiltradoItens[nomeItem].qtd += qtd;
        totalFiltradoQtd += qtd;
      }
    });

    // Atualiza os Cards Superiores com base no Filtro Geral
    document.getElementById('apresTotalGeral').innerText = totalGeralQtd.toLocaleString('pt-BR');
    document.getElementById('apresTotalFiltrado').innerText = totalFiltradoQtd.toLocaleString('pt-BR') + ' peças';

    // Tabela 1: Total Geral por Item (Filtro Geral)
    let tbodyGeral = document.getElementById('tabelaGeralItens');
    tbodyGeral.innerHTML = '';
    const itensGeralOrdenados = Object.values(mapaGeralItens).sort((a, b) => b.qtd - a.qtd);
    
    if (itensGeralOrdenados.length === 0) {
      tbodyGeral.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhum registro no período geral.</td></tr>`;
    } else {
      itensGeralOrdenados.forEach(i => {
        tbodyGeral.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${i.item}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: var(--primary);">${i.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    // Tabela 2: Média por Mês (Filtro Geral)
    let tbodyMes = document.getElementById('tabelaMediaMes');
    tbodyMes.innerHTML = '';
    const mesesArray = Object.values(mapaGeralMes).sort((a, b) => b.anoMes.localeCompare(a.anoMes));
    
    if (mesesArray.length === 0) {
      tbodyMes.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Sem dados mensais no período.</td></tr>`;
    } else {
      let totalMesesUnicos = mesesArray.length || 1;
      document.getElementById('apresMediaMensalGeral').innerText = Math.round(totalGeralQtd / totalMesesUnicos).toLocaleString('pt-BR');

      mesesArray.slice(0, 10).forEach(m => {
        const dateStr = new Date(m.anoMes + '-01T00:00:00').toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
        const formatadoBonito = dateStr.charAt(0).toUpperCase() + dateStr.slice(1);

        tbodyMes.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600; text-transform: capitalize;">${formatadoBonito}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #3B82F6;">${m.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    // Tabela 3: Produção por Unidades / Oficinas (Filtro Geral)
    let tbodyOficinas = document.getElementById('tabelaOficinasGeral');
    tbodyOficinas.innerHTML = '';
    const oficinasOrdenadas = Object.entries(mapaOficinasGeral).sort((a, b) => b[1] - a[1]);

    if (oficinasOrdenadas.length === 0) {
      tbodyOficinas.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhuma unidade encontrada.</td></tr>`;
    } else {
      oficinasOrdenadas.forEach(([nomeOficina, qtdOficina]) => {
        tbodyOficinas.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${nomeOficina}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #8B5CF6;">${qtdOficina.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    // Tabela 4: Filtro Personalizado (Bloco Inferior)
    let tbodyFiltro = document.getElementById('tabelaFiltroPersonalizado');
    tbodyFiltro.innerHTML = '';
    const itensFiltradosOrdenados = Object.values(mapaFiltradoItens).sort((a, b) => b.qtd - a.qtd);

    if (itensFiltradosOrdenados.length === 0) {
      tbodyFiltro.innerHTML = `<tr><td colspan="2" style="padding: 15px; text-align: center; color: var(--text-muted); font-weight: 500;">Nenhum dado encontrado no período selecionado.</td></tr>`;
    } else {
      itensFiltradosOrdenados.forEach(i => {
        tbodyFiltro.innerHTML += `
          <tr style="border-bottom: 1px dashed var(--border);">
            <td style="padding: 12px 10px; font-weight: 600;">${i.item}</td>
            <td style="padding: 12px 10px; text-align: right; font-weight: 800; color: #10B981;">${i.qtd.toLocaleString('pt-BR')} peças</td>
          </tr>`;
      });
    }

    // Renderiza os Gráficos com base no Filtro Geral
    renderizarGraficosApres(itensGeralOrdenados, mesesArray.reverse());
  }

  function renderizarGraficosApres(itensArr, mesesArr) {
    const isDark = document.body.classList.contains('dark-mode');
    const gridColor = isDark ? '#37474f' : '#e2e8f0';
    const textColor = isDark ? '#a0abb5' : '#64748b';

    // Gráfico de Itens (Barra)
    const ctxItens = document.getElementById('graficoItensApres').getContext('2d');
    if (chartInstItensApres) chartInstItensApres.destroy();

    chartInstItensApres = new Chart(ctxItens, {
      type: 'bar',
      data: {
        labels: itensArr.map(i => i.item),
        datasets: [{
          label: 'Peças Produzidas',
          data: itensArr.map(i => i.qtd),
          backgroundColor: '#001E7A',
          borderRadius: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: { top: 35 } },
        plugins: {
          legend: { display: false },
          datalabels: {
            anchor: 'end',
            align: 'top',
            color: textColor,
            font: { weight: 'bold', size: 11, family: 'Poppins' },
            formatter: (value) => value.toLocaleString('pt-BR')
          }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: gridColor }, ticks: { font: { size: 11, family: 'Poppins' }, color: textColor } },
          x: { grid: { display: false }, ticks: { font: { size: 10, family: 'Poppins' }, maxRotation: 45, minRotation: 45, color: textColor } }
        }
      },
      plugins: [ChartDataLabels]
    });

    // Gráfico de Meses (Linha)
    const ctxMes = document.getElementById('graficoMesApres').getContext('2d');
    if (chartInstMesApres) chartInstMesApres.destroy();

    chartInstMesApres = new Chart(ctxMes, {
      type: 'line',
      data: {
        labels: mesesArr.map(m => {
          let partes = m.anoMes.split('-');
          return `${partes[1]}/${partes[0]}`;
        }),
        datasets: [{
          label: 'Peças no Mês',
          data: mesesArr.map(m => m.qtd),
          borderColor: '#3B82F6',
          backgroundColor: 'rgba(59, 130, 246, 0.15)',
          fill: true,
          tension: 0.3,
          pointRadius: 6,
          pointBackgroundColor: '#3B82F6'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: { top: 35 } },
        plugins: {
          legend: { display: false },
          datalabels: {
            align: 'top',
            color: textColor,
            font: { weight: 'bold', size: 11, family: 'Poppins' },
            formatter: (value) => value.toLocaleString('pt-BR')
          }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: gridColor }, ticks: { font: { size: 11, family: 'Poppins' }, color: textColor } },
          x: { grid: { display: false }, ticks: { font: { size: 11, family: 'Poppins' }, color: textColor } }
        }
      },
      plugins: [ChartDataLabels]
    });
  }

  // Executa ao carregar e quando o filtro global for acionado
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof renderPageApres === 'undefined') {
      window.renderPageApres = renderPageApresentacao;
    }
    renderPageApresentacao();
  });
</script>