        <div>
          <label style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 5px;">Mês Específico</label>
          <input type="month" id="apresFiltroMes" onchange="mudarFiltroMesApresentacao()">
