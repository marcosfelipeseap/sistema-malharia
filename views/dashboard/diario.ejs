<!-- =========================================================
     PAGE 1 — DIÁRIO DE PRODUÇÃO
     ========================================================= -->
<div id="page1" class="page active">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; flex-wrap:wrap; gap:15px;">
    <h2 id="page1Title" style="margin-bottom:0; font-size: 1.6rem;">
      Diário de Produção
    </h2>

    <div style="display:flex; gap:15px; align-items:flex-end; flex-wrap:wrap;">
      <button class="btn-notif" onclick="generateDiarioRelatorio()" style="padding:0 20px; height:44px; border: none; background: #25D366; color: #fff; border-radius: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: var(--shadow); transition: 0.2s;">
        <i class="bi bi-whatsapp" style="font-size: 1.1rem;"></i> RELATÓRIO
      </button>

      <div class="filter-group" style="display: flex; flex-direction: column; gap: 5px;">
        <label style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Data de Acompanhamento</label>
        <input type="date" id="dailyDate" onchange="renderPage1()" style="height: 44px; width: 160px;">
      </div>
    </div>
  </div>

  <div id="dailySummary" class="p1-summary-row" style="display: flex; gap: 15px; margin-bottom: 30px; flex-wrap: wrap;"></div>
  <div id="dailyCards" class="cards-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 25px;"></div>
</div>

<script>
function renderPage1() {
    let val = document.getElementById('dailyDate').value;
    if (!val) return;

    let sDate = val.split('-').reverse().join('/');
    let selDateObj = new Date(val.split('-')[0], val.split('-')[1] - 1, val.split('-')[2]);
    let isWeekendDay = selDateObj.getDay() === 0 || selDateObj.getDay() === 6;
    
    // Mescla os dados do sistema e da planilha, alinhando a nomenclatura da meta
    let dadosCompletos = [...rawData];
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let antigosMarcados = dadosAntigos.map(d => ({ 
            ...d, 
            isPlanilha: true,
            metaOficina: d.meta || 0 // Mapeia a meta da planilha para o padrão do sistema
        }));
        dadosCompletos = [...dadosCompletos, ...antigosMarcados];
    }

    let data = dadosCompletos.filter(r => r.data === sDate);
    let feriadosHoje = feriadosData.filter(f => f.data === sDate);

    let cont = document.getElementById('dailyCards');
    let summaryCont = document.getElementById('dailySummary');

    cont.innerHTML = '';
    summaryCont.innerHTML = '';

    // LÓGICA INTELIGENTE: Puxa oficinas antigas apenas se estiverem dentro do seu período de atividade
    let allOficinasSet = new Set(rawData.map(r => r.oficina));
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let maxDateAntigos = {};
        dadosAntigos.forEach(r => {
            if (!maxDateAntigos[r.oficina] || r.dateObj > maxDateAntigos[r.oficina]) {
                maxDateAntigos[r.oficina] = r.dateObj;
            }
        });
        dadosAntigos.forEach(r => {
            if (selDateObj <= maxDateAntigos[r.oficina]) {
                allOficinasSet.add(r.oficina);
            }
        });
    }
    let allOficinas = [...allOficinasSet].sort();
    let groups = {};

    data.forEach(r => {
        if (!groups[r.oficina]) groups[r.oficina] = { prod: 0, items: [] };
        groups[r.oficina].prod += r.producaoDia;
        groups[r.oficina].items.push(r);
    });

    let listOk = [], listFail = [], listInsumo = [], listMissing = [], listFeriado = [];

    Object.keys(groups).forEach(of => {
        let g = groups[of];
        let validItems = g.items.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
        g.meta = validItems.length > 0 ? calculateDynamicMeta(validItems) : 0;
        let hasInsumoIssue = g.items.some(j => isSemInsumo(j.justificativa));

        if (g.prod > 0 && g.prod >= g.meta) listOk.push(of);
        else if (g.prod === 0 && hasInsumoIssue) listInsumo.push(of);
        else listFail.push(of);
    });

    let presentOficinas = Object.keys(groups);
    let maxDates = {};

    rawData.forEach(r => {
        if (!maxDates[r.oficina] || r.dateObj > maxDates[r.oficina]) maxDates[r.oficina] = r.dateObj;
    });

    allOficinas.forEach(of => {
        if (!presentOficinas.includes(of)) {
            let fGlobal = feriadosHoje.find(f => f.oficina === 'Todas');
            let fSpecific = feriadosHoje.find(f => f.oficina === of);

            if (fGlobal || fSpecific) {
                listFeriado.push({
                    oficina: of,
                    descricao: fGlobal ? fGlobal.descricao : fSpecific.descricao
                });
            } else if (!isWeekendDay) {
                if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && selDateObj > (maxDates[of] || new Date(0))) {} 
                else listMissing.push(of);
            }
        }
    });

    document.getElementById('page1Title').innerHTML = `Diário de Produção ${isWeekendDay ? `<span style="font-size:0.85rem; background:var(--warning-bg); color:var(--warning-text-dark); padding:6px 12px; border-radius:8px; margin-left:15px; font-weight:700; text-transform: uppercase; vertical-align: middle;">Fim de Semana</span>` : ''}`;

    listOk.sort(); listInsumo.sort(); listFail.sort(); listMissing.sort();
    listFeriado.sort((a, b) => a.oficina.localeCompare(b.oficina));

    summaryCont.innerHTML = `
        <div class="p1-stat-card" style="border-left:6px solid var(--success-text); background: var(--surface); padding: 20px; border-radius: 16px; flex: 1; min-width: 140px; box-shadow: var(--shadow);">
            <div style="font-size:0.75rem; text-transform:uppercase; color:var(--text-muted); font-weight:700; margin-bottom: 5px;">Satisfatório</div>
            <div class="p1-stat-val" style="color:var(--success-text); font-size: 28px; font-weight: 800; line-height: 1;">${listOk.length}</div>
        </div>
        <div class="p1-stat-card" style="border-left:6px solid var(--warning-text-dark); background: var(--surface); padding: 20px; border-radius: 16px; flex: 1; min-width: 140px; box-shadow: var(--shadow);">
            <div style="font-size:0.75rem; text-transform:uppercase; color:var(--text-muted); font-weight:700; margin-bottom: 5px;">Sem Insumo</div>
            <div class="p1-stat-val" style="color:var(--warning-text-dark); font-size: 28px; font-weight: 800; line-height: 1;">${listInsumo.length}</div>
        </div>
        <div class="p1-stat-card" style="border-left:6px solid var(--danger-text); background: var(--surface); padding: 20px; border-radius: 16px; flex: 1; min-width: 140px; box-shadow: var(--shadow);">
            <div style="font-size:0.75rem; text-transform:uppercase; color:var(--text-muted); font-weight:700; margin-bottom: 5px;">Insuficiente</div>
            <div class="p1-stat-val" style="color:var(--danger-text); font-size: 28px; font-weight: 800; line-height: 1;">${listFail.length}</div>
        </div>
        <div class="p1-stat-card" style="border-left:6px solid #00ACC1; background: var(--surface); padding: 20px; border-radius: 16px; flex: 1; min-width: 140px; box-shadow: var(--shadow);">
            <div style="font-size:0.75rem; text-transform:uppercase; color:var(--text-muted); font-weight:700; margin-bottom: 5px;">Feriado</div>
            <div class="p1-stat-val" style="color:#00ACC1; font-size: 28px; font-weight: 800; line-height: 1;">${listFeriado.length}</div>
        </div>
        <div class="p1-stat-card" style="border-left:6px solid var(--neutral-text); background: var(--surface); padding: 20px; border-radius: 16px; flex: 1; min-width: 140px; box-shadow: var(--shadow);">
            <div style="font-size:0.75rem; text-transform:uppercase; color:var(--text-muted); font-weight:700; margin-bottom: 5px;">Não Informado</div>
            <div class="p1-stat-val" style="color:var(--neutral-text); font-size: 28px; font-weight: 800; line-height: 1;">${listMissing.length}</div>
        </div>
    `;

    if (!listOk.length && !listInsumo.length && !listFail.length && !listMissing.length && !listFeriado.length) {
        cont.innerHTML = `<div style="color:var(--text-muted); font-weight: 500; font-size: 1.1rem;">Nenhum registro para esta data.</div>`;
        return;
    }

    let presentSorted = [...listOk, ...listInsumo, ...listFail];

    presentSorted.forEach(of => {
        let g = groups[of];
        let bateu = g.prod > 0 && g.prod >= g.meta;
        let isInsumo = listInsumo.includes(of);

        let itemsHtml = g.items.map(i => {
            if (i.item === 'Nenhum') return ''; 
            
            let isPlanilha = i.isPlanilha === true;
            let tagsHtml = '';
            
            if (isPlanilha) {
                tagsHtml += `<span style="background:#FFF3E0; color:#E65100; padding:4px 8px; border-radius:6px; font-size:0.65rem; font-weight:700; text-transform: uppercase;">Dados da Planilha - Sem detalhamento</span>`;
            } else {
                if (i.tamanho) tagsHtml += `<span style="background:var(--primary-light); color:var(--primary); padding:4px 8px; border-radius:6px; font-size:0.7rem; font-weight:700; text-transform: uppercase;">Tam: ${i.tamanho}</span>`;
                if (i.processoNome && i.processoNome !== '-') tagsHtml += `<span style="background:var(--neutral-bg); color:var(--neutral-text); padding:4px 8px; border-radius:6px; font-size:0.7rem; font-weight:700; text-transform: uppercase;">Órgão: ${i.processoNome}</span>`;
            }

            return `
                <div class="item-row" style="display: flex; flex-direction: column; padding: 12px 0; border-bottom: 1px dashed var(--border);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-main);">${i.item} <span style="color:var(--text-muted); font-weight: 500;">${isPlanilha ? '' : `(${i.tipo})`}</span></div>
                        <div style="font-size: 1.1rem; font-weight: 800; color:var(--primary);">${i.producaoDia}</div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        ${tagsHtml}
                    </div>
                </div>
            `;
        }).join('');

        let infoMaq = g.items[0].maquinas || '?';
        let infoInt = g.items[0].qtd_internos || g.items[0].internos || '?';
        let uniqJust = [...new Set(g.items.map(i => i.justificativa))].filter(j => j && j.trim() !== "");
        let uniqObs = [...new Set(g.items.map(i => i.observacao))].filter(o => o && o.trim() !== "");
        let perc = g.meta > 0 ? Math.round((g.prod / g.meta) * 100) : 0;
        if (g.meta === 0 && isInsumo) perc = 0;

        let statusText = 'INSUFICIENTE'; let statusColor = 'var(--danger-bg)'; let statusTextColor = 'var(--danger-text)';
        if (bateu) { statusText = 'SATISFATÓRIO'; statusColor = 'var(--success-bg)'; statusTextColor = 'var(--success-text)'; } 
        else if (isInsumo) { statusText = 'SEM INSUMO'; statusColor = 'var(--warning-bg)'; statusTextColor = 'var(--warning-text-dark)'; }

        let card = document.createElement('div');
        card.className = 'card';
        card.style.background = 'var(--surface)'; card.style.borderRadius = '20px'; card.style.overflow = 'hidden'; card.style.boxShadow = 'var(--shadow)';

        let cardHtml = `
            <div class="card-header" style="padding: 20px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; background: var(--primary-light);">
                <div style="display:flex; flex-direction:column; justify-content:center;">
                    <span style="font-weight:800; color:var(--primary); font-size: 1.1rem; text-transform: uppercase;">${of}</span>
                    <div style="font-size:0.75rem; color:var(--text-muted); font-weight:600; margin-top:6px; display:flex; flex-direction:column; gap:2px; text-transform: uppercase;">
                        <span>Máquinas: ${infoMaq}</span><span>Internos: ${infoInt}</span>
                    </div>
                </div>
                <span style="font-size:0.7rem; padding:6px 12px; background: ${statusColor}; color: ${statusTextColor}; border-radius: 20px; font-weight: 800; letter-spacing:0.5px;">${statusText}</span>
            </div>
            
            <div class="card-body" style="padding:20px">
                <div style="display:flex; justify-content:space-between; margin-bottom:20px; align-items:flex-end;">
                    <div>
                        <small style="font-weight:700; color:var(--text-muted); display: block; font-size: 0.7rem; text-transform: uppercase;">PRODUÇÃO</small>
                        <div style="font-size:2.2rem; font-weight:800; line-height:1; color:var(--text-main); margin-bottom: 4px;">${g.prod}</div>
                        <small style="font-weight:700; color:var(--text-muted); font-size: 0.7rem; text-transform: uppercase;">PERFORMANCE</small>
                    </div>
                    <div style="text-align:right">
                        <small style="color:var(--text-muted); display: block; font-weight: 700; font-size: 0.7rem; text-transform: uppercase;">META</small>
                        <div style="font-size:1.4rem; color:var(--text-muted); font-weight: 800; line-height:1.2; margin-bottom: 4px;">${g.meta}</div>
                        <div style="font-size:1.2rem; font-weight:800; color: ${statusTextColor}; line-height:1;">${perc}%</div>
                    </div>
                </div>
        `;

        if (itemsHtml !== '') {
            cardHtml += `<div style="background:var(--bg-body); padding:10px 20px; border-radius:12px; margin-bottom:15px; border: 1px solid var(--border);">${itemsHtml}</div>`;
        }

        if (uniqJust.length > 0 || uniqObs.length > 0) {
            let infoBg = !bateu ? 'var(--danger-bg)' : 'var(--neutral-bg)';
            let infoBorder = !bateu ? 'var(--danger-text)' : 'var(--border)';
            let infoText = !bateu ? 'var(--danger-text)' : 'var(--text-muted)';
            
            cardHtml += `<div style="border-left: 4px solid ${infoBorder}; background: ${infoBg}; border-radius:0 12px 12px 0; padding:15px; font-size:0.85rem; margin-top:10px; color:${infoText};">`;
            if (uniqJust.length > 0) cardHtml += `<div style="margin-bottom: ${uniqObs.length > 0 ? '8px' : '0'}"><span style="font-weight:700;">Justificativa:</span> ${uniqJust.join(', ')}</div>`;
            if (uniqObs.length > 0) cardHtml += `<div><span style="font-weight:700; color:var(--text-main);">Obs:</span> <span style="color:var(--text-muted);">${uniqObs.join(' | ')}</span></div>`;
            cardHtml += `</div>`;
        }
        cardHtml += `</div>`;
        card.innerHTML = cardHtml;
        cont.appendChild(card);
    });

    listFeriado.forEach(f => {
        let card = document.createElement('div');
        card.className = 'card';
        card.style.background = 'var(--surface)'; card.style.borderRadius = '20px'; card.style.overflow = 'hidden'; card.style.boxShadow = 'var(--shadow)';
        card.innerHTML = `
            <div class="card-header" style="background:#E0F7FA; padding: 20px; border-bottom:1px solid #B2EBF2; display:flex; justify-content:space-between; align-items:center;">
                <div style="display:flex; flex-direction:column; justify-content:center;">
                    <span style="font-weight:800; color:#00838F; font-size: 1.1rem; text-transform: uppercase;">${f.oficina}</span>
                    <div style="font-size:0.75rem; color:#00ACC1; font-weight:700; margin-top:6px; display:flex; flex-direction:column; gap:2px; text-transform: uppercase;">
                        <span>Máquinas: N/A</span><span>Internos: N/A</span>
                    </div>
                </div>
                <span style="font-size:0.7rem; padding:6px 12px; background: #00ACC1; color: #FFFFFF; border-radius: 20px; font-weight: 800; letter-spacing:0.5px;">FERIADO</span>
            </div>
            <div class="card-body" style="padding:20px; opacity:0.8;">
                <div style="display:flex; justify-content:space-between; align-items:flex-end;">
                    <div>
                        <small style="font-weight:700; color:var(--text-muted); display: block; font-size: 0.7rem; text-transform: uppercase;">PRODUÇÃO</small>
                        <div style="font-size:2.2rem; font-weight:800; line-height:1; color:var(--text-muted); margin-bottom:4px;">0</div>
                    </div>
                    <div style="text-align:right">
                        <small style="color:var(--text-muted); display: block; font-weight: 700; font-size: 0.7rem; text-transform: uppercase;">META</small>
                        <div style="font-size:1.4rem; color:var(--text-muted); font-weight: 800; line-height:1.2; margin-bottom: 4px;">?</div>
                    </div>
                </div>
                <div style="border-left:4px solid #00ACC1; background: #E0F7FA; border-radius:0 12px 12px 0; padding:15px; font-size:0.85rem; margin-top:20px; color:#00838F;">
                    <span style="font-weight:700;">Motivo:</span> ${f.descricao}
                </div>
            </div>
        `;
        cont.appendChild(card);
    });

    listMissing.forEach(of => {
        let card = document.createElement('div');
        card.className = 'card';
        card.style.background = 'var(--surface)'; card.style.borderRadius = '20px'; card.style.overflow = 'hidden'; card.style.boxShadow = 'var(--shadow)'; card.style.opacity = '0.8';
        card.innerHTML = `
            <div class="card-header" style="background:var(--neutral-bg); padding: 20px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
                <div style="display:flex; flex-direction:column; justify-content:center;">
                    <span style="font-weight:800; color:var(--text-muted); font-size: 1.1rem; text-transform: uppercase;">${of}</span>
                    <div style="font-size:0.75rem; color:var(--text-muted); font-weight:700; margin-top:6px; display:flex; flex-direction:column; gap:2px; text-transform: uppercase;">
                        <span>Máquinas: N/A</span><span>Internos: N/A</span>
                    </div>
                </div>
                <span style="font-size:0.7rem; padding:6px 12px; background: var(--border); color: var(--text-muted); border-radius: 20px; font-weight: 800; letter-spacing:0.5px;">NÃO INFORMADO</span>
            </div>
            <div class="card-body" style="padding:20px; opacity:0.6;">
                <div style="display:flex; justify-content:space-between; align-items:flex-end;">
                    <div>
                        <small style="font-weight:700; color:var(--text-muted); display: block; font-size: 0.7rem; text-transform: uppercase;">PRODUÇÃO</small>
                        <div style="font-size:2.2rem; font-weight:800; line-height:1; color:var(--text-muted); margin-bottom:4px;">0</div>
                    </div>
                    <div style="text-align:right">
                        <small style="color:var(--text-muted); display: block; font-weight: 700; font-size: 0.7rem; text-transform: uppercase;">META</small>
                        <div style="font-size:1.4rem; color:var(--text-muted); font-weight: 800; line-height:1.2; margin-bottom: 4px;">?</div>
                    </div>
                </div>
            </div>
        `;
        cont.appendChild(card);
    });
}

function generateDiarioRelatorio() {
    let val = document.getElementById('dailyDate').value;
    if (!val) return;

    let sDate = val.split('-').reverse().join('/');
    let selDateObj = new Date(val.split('-')[0], val.split('-')[1] - 1, val.split('-')[2]);
    let isWeekendDay = selDateObj.getDay() === 0 || selDateObj.getDay() === 6;
    
    // Mescla os dados para o relatório, alinhando a nomenclatura da meta
    let dadosCompletos = [...rawData];
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let antigosMarcados = dadosAntigos.map(d => ({ 
            ...d, 
            isPlanilha: true,
            metaOficina: d.meta || 0 // Mapeia a meta
        }));
        dadosCompletos = [...dadosCompletos, ...antigosMarcados];
    }
    
    let data = dadosCompletos.filter(r => r.data === sDate);
    let feriadosHoje = feriadosData.filter(f => f.data === sDate);
    
    let allOficinasSet = new Set(rawData.map(r => r.oficina));
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let maxDateAntigos = {};
        dadosAntigos.forEach(r => {
            if (!maxDateAntigos[r.oficina] || r.dateObj > maxDateAntigos[r.oficina]) {
                maxDateAntigos[r.oficina] = r.dateObj;
            }
        });
        dadosAntigos.forEach(r => {
            if (selDateObj <= maxDateAntigos[r.oficina]) {
                allOficinasSet.add(r.oficina);
            }
        });
    }
    let allOficinas = [...allOficinasSet].sort();
    let groups = {};

    data.forEach(r => {
        if (!groups[r.oficina]) groups[r.oficina] = { prod: 0, items: [] };
        groups[r.oficina].prod += r.producaoDia;
        groups[r.oficina].items.push(r);
    });

    let listOk = [], listFail = [], listInsumo = [], listMissing = [], listFeriado = [];

    Object.keys(groups).forEach(of => {
        let g = groups[of];
        let validItems = g.items.filter(r => !(r.producaoDia === 0 && isSemInsumo(r.justificativa)));
        g.meta = validItems.length > 0 ? calculateDynamicMeta(validItems) : 0;
        let hasInsumoIssue = g.items.some(j => isSemInsumo(j.justificativa));

        if (g.prod > 0 && g.prod >= g.meta) listOk.push(of);
        else if (g.prod === 0 && hasInsumoIssue) listInsumo.push(of);
        else listFail.push(of);
    });

    let maxDates = {};
    rawData.forEach(r => { if (!maxDates[r.oficina] || r.dateObj > maxDates[r.oficina]) maxDates[r.oficina] = r.dateObj; });

    allOficinas.forEach(of => {
        if (!presentOficinas.includes(of)) {
            let fGlobal = feriadosHoje.find(f => f.oficina === 'Todas');
            let fSpecific = feriadosHoje.find(f => f.oficina === of);
            if (fGlobal || fSpecific) listFeriado.push({ oficina: of, descricao: fGlobal ? fGlobal.descricao : fSpecific.descricao });
            else if (!isWeekendDay) { if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && selDateObj > (maxDates[of] || new Date(0))) {} else listMissing.push(of); }
        }
    });

    listOk.sort(); listInsumo.sort(); listFail.sort(); listMissing.sort(); listFeriado.sort((a, b) => a.oficina.localeCompare(b.oficina));

    let text = `*📊 DIÁRIO DE PRODUÇÃO - ${sDate}*\n`;
    if (isWeekendDay) text += `*(Fim de Semana)*\n`;

    text += `\n*Resumo:*\n✅ Satisfatório: ${listOk.length}\n⚠️ Sem Insumo: ${listInsumo.length}\n❌ Insuficiente: ${listFail.length}\n🏖️ Feriado: ${listFeriado.length}\n⚪ Não Informado: ${listMissing.length}\n\n*--- DETALHAMENTO ---*\n\n`;

    let presentSorted = [...listOk, ...listInsumo, ...listFail];
    presentSorted.forEach(of => {
        let g = groups[of];
        let bateu = g.prod > 0 && g.prod >= g.meta;
        let isInsumo = listInsumo.includes(of);
        let statusText = bateu ? '✅ SATISFATÓRIO' : (isInsumo ? '⚠️ SEM INSUMO' : '❌ INSUFICIENTE');
        let perc = g.meta > 0 ? Math.round((g.prod / g.meta) * 100) : (isInsumo ? 0 : 100);

        text += `🏢 *${of}*\nMáquinas: ${g.items[0].maquinas || '?'} | Internos: ${g.items[0].qtd_internos || g.items[0].internos || '?'}\nStatus: ${statusText}\nProdução: ${g.prod} / Meta: ${g.meta} (${perc}%)\n`;

        g.items.forEach(i => {
            if(i.item !== 'Nenhum') {
                if (i.isPlanilha) {
                    text += `- ${i.producaoDia}x ${i.item} *(Dados da Planilha - Sem detalhamento)*\n`;
                } else {
                    let infoExtra = [];
                    if(i.processoNome && i.processoNome !== '-') infoExtra.push(`Órgão: ${i.processoNome}`);
                    if(i.tamanho) infoExtra.push(`Tam: ${i.tamanho}`);
                    text += `- ${i.producaoDia}x ${i.item} (${i.tipo || '-'})${infoExtra.length > 0 ? ` [${infoExtra.join(' | ')}]` : ''}\n`;
                }
            }
        });

        let uniqJust = [...new Set(g.items.map(i => i.justificativa))].filter(j => j && j.trim() !== "");
        let uniqObs = [...new Set(g.items.map(i => i.observacao))].filter(o => o && o.trim() !== "");

        if (uniqJust.length > 0) text += `Justificativa: ${uniqJust.join(', ')}\n`;
        else if (!bateu) text += `Justificativa: Não informado\n`;
        
        if (uniqObs.length > 0) text += `Obs: ${uniqObs.join(' | ')}\n`;
        text += `\n`;
    });

    if (listFeriado.length > 0) {
        text += `*🏖️ FERIADOS / RECESSOS:*\n`;
        listFeriado.forEach(f => { text += `- ${f.oficina} (${f.descricao})\n`; });
        text += `\n`;
    }

    if (listMissing.length > 0) {
        text += `*⚪ NÃO INFORMADOS:*\n`;
        listMissing.forEach(of => { text += `- ${of}\n`; });
    }

    if (typeof openWhatsModal === 'function') openWhatsModal(text.trim());
    else window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text.trim())}`, '_blank');
}
</script>