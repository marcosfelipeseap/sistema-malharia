<!-- =========================================================
     PAGE 3 — DESEMPENHO (META X PRODUÇÃO)
     ========================================================= -->
<div id="page2" class="page">
  <h2 style="font-size: 1.6rem; margin-bottom: 5px;">Desempenho (Meta x Produção)</h2>
  <p style="font-size: 0.85rem; font-weight: 500; color:var(--text-muted); margin-bottom: 20px;">Selecione as oficinas abaixo para visualizar os gráficos comparativos detalhados integrando o Histórico da Planilha e o Novo Sistema.</p>
  
  <div style="display: flex; gap: 15px; margin-bottom: 20px; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); align-items: center;">
    <span style="display: flex; align-items: center; gap: 5px;"><span style="width: 15px; height: 3px; background: #F59E0B; display: inline-block;"></span> Histórico da Planilha</span>
    <span style="display: flex; align-items: center; gap: 5px;"><span style="width: 15px; height: 3px; background: #1E88E5; display: inline-block;"></span> Novo Sistema</span>
  </div>

  <div id="oficinaChips" class="chip-container" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px;"></div>
  <div id="chartsArea" style="display: flex; flex-direction: column; gap: 25px;"></div>
</div>

<script>
  function setupChips() {
    let dates = typeof getFilterDates === 'function' ? getFilterDates() : { start: new Date(0), end: new Date() };
    
    let dadosCompletos = [...rawData];
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let antigosMarcados = dadosAntigos.map(d => ({ ...d, isPlanilha: true, metaOficina: d.meta || 0 }));
        dadosCompletos = [...dadosCompletos, ...antigosMarcados];
    }

    let filtered = dadosCompletos.filter(r => r.dateObj >= dates.start && r.dateObj <= dates.end);
    let cont = document.getElementById('oficinaChips');
    if (!cont) return;
    cont.innerHTML = '';
    
    let oficinasNoSistema = new Set(rawData.map(r => r.oficina));
    let list = [...new Set(filtered.map(r => r.oficina))].filter(o => oficinasNoSistema.has(o)).sort();
    
    selectedOficinas = selectedOficinas.filter(o => list.includes(o));
    
    if (list.length === 0) { 
      cont.innerHTML = '<span style="font-size:0.9rem; font-weight: 500; color:var(--text-muted)">Nenhuma oficina do sistema ativo possui dados neste período.</span>'; 
      return;
    }
    
    list.forEach(of => {
      let c = document.createElement('div');
      c.className = 'chip'; 
      c.style.padding = '10px 20px'; c.style.borderRadius = '20px'; c.style.border = '1px solid var(--border)'; c.style.background = 'var(--surface)'; c.style.cursor = 'pointer'; c.style.fontSize = '0.85rem'; c.style.fontWeight = '600'; c.style.color = 'var(--text-muted)'; c.style.transition = '0.2s'; c.style.textTransform = 'uppercase';
      
      if (selectedOficinas.includes(of)) {
          c.classList.add('selected');
          c.style.background = 'var(--primary)'; c.style.color = '#fff'; c.style.borderColor = 'var(--primary)'; c.style.boxShadow = 'var(--shadow)';
      }

      c.innerText = of;
      c.onclick = () => {
        if (selectedOficinas.includes(of)) { 
          selectedOficinas = selectedOficinas.filter(x => x !== of); 
          c.classList.remove('selected'); 
          c.style.background = 'var(--surface)'; c.style.color = 'var(--text-muted)'; c.style.borderColor = 'var(--border)'; c.style.boxShadow = 'none';
        } else { 
          selectedOficinas.push(of); 
          c.classList.add('selected'); 
          c.style.background = 'var(--primary)'; c.style.color = '#fff'; c.style.borderColor = 'var(--primary)'; c.style.boxShadow = 'var(--shadow)';
        }
        renderPage2();
      };
      cont.appendChild(c);
    });
    
    let page2 = document.getElementById('page2');
    if (page2 && page2.classList.contains('active')) renderPage2();
  }

  function renderPage2() {
    let area = document.getElementById('chartsArea'); 
    if (!area) return;
    area.innerHTML = ''; 
    activeCharts = [];
    
    if (selectedOficinas.length === 0) {
        area.innerHTML = '<div style="text-align:center; padding: 40px; color: var(--text-muted); font-weight: 500; font-size: 1rem; background: var(--surface); border-radius: 20px; box-shadow: var(--shadow);">Selecione ao menos uma oficina acima para exibir os gráficos de desempenho.</div>';
        return;
    }

    let datesFilter = typeof getFilterDates === 'function' ? getFilterDates() : { start: new Date(0), end: new Date() };
    
    let dadosCompletos = [...rawData];
    if (typeof dadosAntigos !== 'undefined' && dadosAntigos.length > 0) {
        let antigosMarcados = dadosAntigos.map(d => ({ ...d, isPlanilha: true, metaOficina: d.meta || 0 }));
        dadosCompletos = [...dadosCompletos, ...antigosMarcados];
    }

    let filtered = dadosCompletos.filter(r => r.dateObj >= datesFilter.start && r.dateObj <= datesFilter.end);
    let dates = [...new Set(filtered.map(r => r.data))].sort((a,b) => { 
      let da = a.split('/'), db = b.split('/'); 
      return new Date(da[2], da[1]-1, da[0]) - new Date(db[2], db[1]-1, db[0]); 
    });
    
    let displayOrder = selectedOficinas.slice().reverse();
    window.tempMissingData = {}; 
    window.tempInsumoData = {}; 

    displayOrder.forEach((of) => {
      let missingDates = typeof getMissingBusinessDaysCustom === 'function' ? getMissingBusinessDaysCustom(of, rawData) : [];
      window.tempMissingData[of] = missingDates; 

      let dayRecords = filtered.filter(x => x.oficina === of);
      let insumoRecords = dayRecords.filter(r => typeof isSemInsumo === 'function' && isSemInsumo(r.justificativa) && r.producaoDia === 0);
      let insumoDatesSet = new Set(insumoRecords.map(r => `${r.data} (${daysOfWeek[r.dateObj.getDay()]})`));
      let insumoDaysList = [...insumoDatesSet];
      window.tempInsumoData[of] = insumoDaysList;

      let totalProd = dayRecords.reduce((a, b) => a + b.producaoDia, 0);
      
      let daysMap = {};
      dayRecords.forEach(r => { 
        if (!daysMap[r.data]) daysMap[r.data] = []; 
        daysMap[r.data].push(r); 
      });
      
      let totalMeta = 0;
      Object.keys(daysMap).forEach(dateStr => {
          let rArr = daysMap[dateStr];
          let dObj = rArr[0].dateObj;
          let recessStart = new Date(2025, 11, 23); 
          let recessEnd = new Date(2026, 0, 2);     
          if (dObj >= recessStart && dObj <= recessEnd) return;
          if (typeof isFeriado === 'function' && isFeriado(dateStr, of)) return;

          let validRecords = rArr.filter(r => !(r.producaoDia === 0 && typeof isSemInsumo === 'function' && isSemInsumo(r.justificativa)));
          if (validRecords.length > 0 && typeof calculateDynamicMeta === 'function') {
            totalMeta += calculateDynamicMeta(validRecords);
          }
      });

      let perfPerc = totalMeta > 0 ? Math.round((totalProd / totalMeta) * 100) : 0;
      if (totalMeta === 0 && totalProd > 0) perfPerc = 100; 
      let perfClass = perfPerc >= 75 ? 'perf-green' : 'perf-red';

      let refMetaRecord = filtered.find(r => r.oficina === of && r.metaOficina > 0);
      let refMeta = refMetaRecord ? refMetaRecord.metaOficina : 0;
      
      let div = document.createElement('div'); 
      div.className = 'chart-card';
      div.style.background = 'var(--surface)'; div.style.padding = '25px'; div.style.borderRadius = '20px'; div.style.border = 'none'; div.style.boxShadow = 'var(--shadow)';
      div.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px; flex-wrap: wrap; gap: 15px;">
            <h3 style="margin:0; font-size:1.2rem; font-weight:800; align-self:center; color:var(--text-main); text-transform: uppercase;">${of}</h3>
            <div class="p2-header-right" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <div class="perf-label ${perfClass}" style="padding: 6px 14px; border-radius: 12px; font-weight: 800; font-size: 0.75rem; background: ${perfPerc >= 75 ? 'var(--success-bg)' : 'var(--danger-bg)'}; color: ${perfPerc >= 75 ? 'var(--success-text)' : 'var(--danger-text)'}; text-transform: uppercase; letter-spacing: 0.5px;">PERFORMANCE: ${perfPerc}%</div>
                ${missingDates.length > 0 ? `<div class="missing-label" onclick="openModal('Relatórios não enviados (Sistema) - ${of}', window.tempMissingData['${of}'])" style="cursor: pointer; background: var(--alert-bg); color: var(--alert-text); padding: 6px 14px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">NÃO ENVIADOS: ${missingDates.length} DIAS</div>` : ''}
                ${insumoDaysList.length > 0 ? `<div class="insumo-label" onclick="openModal('Dias sem Insumo (Prod: 0) - ${of}', window.tempInsumoData['${of}'])" style="cursor: pointer; background: var(--insumo-bg); color: var(--insumo-text); padding: 6px 14px; border-radius: 12px; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">SEM INSUMO: ${insumoDaysList.length} DIAS</div>` : ''}
            </div>
        </div>
        <div style="height:320px"><canvas></canvas></div>`;
      area.appendChild(div);

      let ofMaxDate = new Date(8640000000000000); 

      // Criação de duas séries separadas para evitar sobreposição feia de cores
      let prodPlanilhaData = dates.map((d) => {
          let pts = d.split('/'); 
          let dObj = new Date(pts[2], pts[1]-1, pts[0]);
          if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && dObj > ofMaxDate) return null;
          if (typeof isFeriado === 'function' && isFeriado(d, of)) return null;

          let rs = filtered.filter(x => x.oficina === of && x.data === d);
          if (rs.length === 0 && typeof isDateWeekend === 'function' && isDateWeekend(d)) return null; 
          
          let planRecs = rs.filter(x => x.isPlanilha);
          if (planRecs.length > 0) {
              return planRecs.reduce((a,b) => a + b.producaoDia, 0) || 0;
          }
          return null;
      });

      let prodSistemaData = dates.map((d) => {
          let pts = d.split('/'); 
          let dObj = new Date(pts[2], pts[1]-1, pts[0]);
          if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && dObj > ofMaxDate) return null;
          if (typeof isFeriado === 'function' && isFeriado(d, of)) return null;

          let rs = filtered.filter(x => x.oficina === of && x.data === d);
          if (rs.length === 0 && typeof isDateWeekend === 'function' && isDateWeekend(d)) return null; 
          
          let sysRecs = rs.filter(x => !x.isPlanilha);
          if (sysRecs.length > 0) {
              return sysRecs.reduce((a,b) => a + b.producaoDia, 0) || 0;
          }
          return null;
      });
      
      let metaData = dates.map(d => {
          let pts = d.split('/'); 
          let dObj = new Date(pts[2], pts[1]-1, pts[0]);
          if ((of === "GALPÃO 3.1" || of === "GALPÃO 3.2") && dObj > ofMaxDate) return null;
          if (typeof isFeriado === 'function' && isFeriado(d, of)) return null;

          let rs = filtered.filter(x => x.oficina === of && x.data === d);
          if (rs.length === 0 && typeof isDateWeekend === 'function' && isDateWeekend(d)) return null; 
          let valid = rs.filter(r => !(r.producaoDia === 0 && typeof isSemInsumo === 'function' && isSemInsumo(r.justificativa)));
          if (valid.length > 0 && typeof calculateDynamicMeta === 'function') return calculateDynamicMeta(valid); 
          let allInsumo = rs.length > 0 && rs.every(r => r.producaoDia === 0 && typeof isSemInsumo === 'function' && isSemInsumo(r.justificativa));
          if (allInsumo) return 0;
          return refMeta;
      });

      const isDark = document.body.classList.contains('dark-mode');
      let gridColor = isDark ? '#37474f' : '#e2e8f0'; 
      let txtColor = isDark ? '#a0abb5' : '#64748b';
      let ctx = div.querySelector('canvas');
      
      let chart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: dates,
          datasets: [
            {
              label: 'Produção (Novo Sistema)', 
              data: prodSistemaData, 
              spanGaps: true, 
              borderColor: '#1E88E5', 
              backgroundColor: '#1E88E5',
              borderWidth: 3, 
              pointRadius: 5, 
              pointBackgroundColor: isDark ? '#1c2126' : '#ffffff', 
              tension: 0.2
            },
            {
              label: 'Produção (Histórico da Planilha)', 
              data: prodPlanilhaData, 
              spanGaps: true, 
              borderColor: '#F59E0B', 
              backgroundColor: '#F59E0B',
              borderWidth: 3, 
              pointRadius: 5, 
              pointBackgroundColor: isDark ? '#1c2126' : '#ffffff', 
              tension: 0.2
            },
            {
              label: 'Meta', 
              data: metaData, 
              spanGaps: true, 
              borderColor: '#EF5350', 
              borderWidth: 2, 
              borderDash: [6,6], 
              pointRadius: 0
            }
          ]
        },
        options: {
          responsive: true, 
          maintainAspectRatio: false,
          scales: { 
            y: { beginAtZero: true, grid: { color: gridColor }, ticks: { color: txtColor, font: {family: 'Poppins'} } }, 
            x: { grid: { display: false }, ticks: { color: txtColor, font: {family: 'Poppins'} } } 
          },
          plugins: { 
            legend: { 
                labels: { 
                    color: txtColor, 
                    font: {family: 'Poppins', weight: '600'}
                } 
            },
            tooltip: {
              titleFont: {family: 'Poppins'}, bodyFont: {family: 'Poppins'},
              callbacks: {
                label: function(context) {
                    if(context.datasetIndex === 2) return `Meta: ${context.parsed.y}`;
                    let datasetLabel = context.dataset.label || '';
                    if (context.parsed.y !== null) return `${datasetLabel}: ${context.parsed.y}`;
                    return null;
                },
                afterBody: function(tooltipItems) {
                  if(tooltipItems[0].datasetIndex === 2) return []; 
                  
                  let idx = tooltipItems[0].dataIndex; 
                  let dateVal = dates[idx];
                  let dayRecords = filtered.filter(x => x.oficina === of && x.data === dateVal);
                  let totalProd = dayRecords.reduce((a, b) => a + b.producaoDia, 0);
                  let validRecords = dayRecords.filter(r => !(r.producaoDia === 0 && typeof isSemInsumo === 'function' && isSemInsumo(r.justificativa)));
                  let dayMeta = (validRecords.length && typeof calculateDynamicMeta === 'function') ? calculateDynamicMeta(validRecords) : refMeta;
                  
                  let finalLines = [];
                  finalLines.push(`--- DETALHES DO DIA ---`);
                  
                  if (dayRecords.length > 0) {
                      let internosUsados = dayRecords[0].qtd_internos || dayRecords[0].internos || '?';
                      let maquinasUsadas = dayRecords[0].maquinas || '?';
                      finalLines.push(`• Máquinas: ${maquinasUsadas} | Internos: ${internosUsados}`);
                  }

                  if (totalProd > 0 && typeof wrapText === 'function') {
                    dayRecords.forEach(r => { 
                        if (r.item !== 'Nenhum') {
                            if (r.isPlanilha) {
                                finalLines.push(...wrapText(`• ${r.producaoDia}x ${r.item} (Histórico da Planilha)`, 55)); 
                            } else {
                                let extra = [];
                                if (r.tamanho) extra.push(`Tam: ${r.tamanho}`);
                                if (r.processoNome && r.processoNome !== '-') extra.push(`Órgão: ${r.processoNome}`);
                                let extraStr = extra.length > 0 ? ` [${extra.join(' | ')}]` : '';
                                finalLines.push(...wrapText(`• ${r.producaoDia}x ${r.item} (${r.tipo || '-'})${extraStr}`, 55)); 
                            }
                        }
                    });
                  }

                  let justs = [...new Set(dayRecords.map(r => r.justificativa).filter(j => j && j.trim() !== ""))];
                  let obss = [...new Set(dayRecords.map(r => r.observacao).filter(o => o && o.trim() !== ""))];

                  if (totalProd < dayMeta) {
                      if (justs.length > 0 && typeof wrapText === 'function') {
                        justs.forEach(j => { finalLines.push(...wrapText(`• Just.: ${j}`, 55)); }); 
                      } else {
                        finalLines.push('• Just.: Não informada');
                      }
                  }

                  if (obss.length > 0 && typeof wrapText === 'function') {
                      obss.forEach(o => { finalLines.push(...wrapText(`• Obs: ${o}`, 55)); });
                  }

                  return finalLines;
                }
              }
            }
          }
        }
      });
      activeCharts.push(chart);
    });
  }
</script>