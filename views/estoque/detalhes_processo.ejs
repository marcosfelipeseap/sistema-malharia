<%- contentFor('body') %>

<style>
    .item-card { transition: transform 0.2s; border-left: 4px solid #0d6efd; }
    .item-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
    .local-row { border-bottom: 1px dashed #e9ecef; padding-bottom: 8px; margin-bottom: 8px; }
    .local-row:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div class="d-flex align-items-center gap-3">
        <a href="javascript:history.back()" class="btn btn-outline-secondary shadow-sm"><i class="bi bi-arrow-left"></i> Voltar</a>
        <h1 class="h2 m-0 text-dark"><i class="bi bi-folder2-open text-warning me-2"></i> Detalhes do Processo</h1>
    </div>
</div>

<!-- CABEÇALHO DO PROCESSO -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div>
                    <h3 class="fw-bold text-primary mb-1"><%= processo.numero_processo %></h3>
                    <h5 class="text-secondary mb-0"><i class="bi bi-building"></i> <%= processo.orgao %></h5>
                </div>
                <div class="d-flex gap-3 text-center">
                    <div class="bg-white px-4 py-2 rounded shadow-sm border">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Total em Estoque</small>
                        <span class="fs-4 fw-bold text-primary"><%= processo.total_geral %></span>
                    </div>
                    <div class="bg-white px-4 py-2 rounded shadow-sm border">
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Já Entregue (Órgão)</small>
                        <span class="fs-4 fw-bold text-success"><%= processo.total_entregue %></span>
                    </div>
                    <% if (processo.total_transito > 0) { %>
                    <div class="bg-white px-4 py-2 rounded shadow-sm border border-warning">
                        <small class="text-warning text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Em Trânsito</small>
                        <span class="fs-4 fw-bold text-warning"><%= processo.total_transito %></span>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-secondary m-0"><i class="bi bi-box-seam"></i> Detalhamento por Itens</h4>
    <div class="input-group shadow-sm" style="max-width: 300px;">
        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar item ou tamanho..." id="buscaItens">
    </div>
</div>

<!-- LISTA DE ITENS -->
<div class="row g-4" id="containerItens">
    <% const itensArray = Object.values(processo.itens); %>
    
    <% if (itensArray.length === 0) { %>
        <div class="col-12">
            <div class="alert alert-secondary text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>
                Nenhum item com estoque ou histórico registrado para este processo.
            </div>
        </div>
    <% } else { %>
        <% itensArray.forEach(item => { %>
            <div class="col-md-6 col-lg-4 card-item-filtro" data-nome="<%= (item.nome || '').toLowerCase() %> <%= (item.tamanho || '').toLowerCase() %>">
                <div class="card h-100 shadow-sm item-card bg-white">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><%= item.nome %></h5>
                            <% if (item.tamanho && item.tamanho !== '-') { %>
                                <span class="badge bg-secondary"><i class="bi bi-tag-fill"></i> Tam: <%= item.tamanho %></span>
                            <% } %>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary fs-6 shadow-sm"><%= item.total_disponivel %> no total</span>
                        </div>
                    </div>
                    
                    <div class="card-body">
                        <hr class="text-muted opacity-25 mt-2 mb-3">
                        
                        <h6 class="fw-bold text-secondary small text-uppercase mb-3">Onde estão estas peças?</h6>
                        
                        <% const locaisArray = Object.values(item.locais); %>
                        <% if (locaisArray.length === 0) { %>
                            <div class="text-muted small text-center py-2 bg-light rounded"><i class="bi bi-exclamation-circle"></i> Estoque zerado nas oficinas e sede.</div>
                        <% } else { %>
                            <% locaisArray.forEach(local => { %>
                                <div class="d-flex justify-content-between align-items-center local-row">
                                    <span class="text-dark fw-medium">
                                        <i class="bi <%= local.isSede ? 'bi-buildings-fill text-primary' : 'bi-shop text-secondary' %> me-2"></i> 
                                        <%= local.nome %>
                                    </span>
                                    <span class="badge <%= local.isSede ? 'bg-primary bg-opacity-10 text-primary border border-primary' : 'bg-light text-dark border' %> rounded-pill px-3">
                                        <%= local.quantidade %> un
                                    </span>
                                </div>
                            <% }); %>
                        <% } %>

                    </div>

                    <div class="card-footer bg-light border-top-0 py-3">
                        <div class="d-flex flex-column gap-2 small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-success fw-bold" title="Total já despachado e finalizado para o Órgão">
                                    <i class="bi bi-check-all fs-6"></i> <%= item.entregue_orgao %> Entregue
                                </span>
                                <% if (item.em_transito > 0) { %>
                                    <span class="badge bg-warning text-dark shadow-sm px-2 py-1" title="Aguardando aprovação">
                                        <i class="bi bi-hourglass-split"></i> <%= item.em_transito %> Trânsito
                                    </span>
                                <% } else { %>
                                    <span class="text-muted" style="opacity: 0.5;"><i class="bi bi-truck"></i> 0 Trânsito</span>
                                <% } %>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top border-secondary border-opacity-25 pt-2 mt-1">
                                <span class="text-secondary fw-bold text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Fabricado (Histórico)</span>
                                <span class="badge bg-secondary shadow-sm px-2 py-1"><%= item.total_produzido_historico %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

<script>
    document.getElementById('buscaItens').addEventListener('keyup', function() {
        const termo = this.value.toLowerCase().trim();
        document.querySelectorAll('.card-item-filtro').forEach(card => {
            const nome = card.getAttribute('data-nome');
            card.style.display = nome.includes(termo) ? '' : 'none';
        });
    });
</script>