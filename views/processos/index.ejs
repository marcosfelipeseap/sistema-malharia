<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Dashboard de Processos</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/processos/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Novo Processo
        </a>
    </div>
</div>

<div class="card mb-4 shadow-sm border-0 bg-light">
    <div class="card-body py-3">
        <div class="position-relative">
            <i class="bi bi-search position-absolute text-muted" style="top: 50%; left: 15px; transform: translateY(-50%);"></i>
            <input type="text" 
                   class="form-control form-control-lg ps-5 border-0 shadow-sm" 
                   id="buscaInput" 
                   placeholder="Pesquise por número, órgão ou situação..." 
                   value="<%= typeof busca !== 'undefined' ? busca : '' %>"
                   autocomplete="off">
        </div>
        <div class="form-text ms-2 mt-2 text-muted small">
            <i class="bi bi-magic"></i> A pesquisa é automática enquanto você digita.
        </div>
    </div>
</div>

<div id="processosGrid" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <% if (processos.length === 0) { %>
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
            <p class="mb-0">Nenhum processo encontrado.</p>
        </div>
    <% } else { %>
        <% processos.forEach(processo => { %>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                    <div class="card-header bg-white border-bottom-0 pt-3 d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge rounded-pill <%= processo.status === 'DEMANDA CONCLUÍDA' ? 'bg-success' : (processo.status === 'ENTREGA NÃO INICIADA' ? 'bg-danger' : 'bg-warning text-dark') %> mb-2">
                                <%= processo.status %>
                            </span>
                            <h5 class="card-title mb-0 fw-bold text-primary">
                                <a href="/processos/<%= processo.id %>" class="text-decoration-none text-primary stretched-link">
                                    Processo <%= processo.numero_processo %>
                                </a>
                            </h5>
                        </div>
                        <div class="dropdown position-relative" style="z-index: 2;">
                            <button class="btn btn-light btn-sm rounded-circle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><a class="dropdown-item" href="/processos/<%= processo.id %>"><i class="bi bi-eye me-2"></i>Ver Detalhes</a></li>
                                <li><a class="dropdown-item" href="/processos/<%= processo.id %>/edit"><i class="bi bi-pencil me-2"></i>Editar</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="/processos/<%= processo.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este processo?');">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Excluir</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card-body pt-0 pb-2">
                        <p class="card-text text-muted small mb-2">
                            <i class="bi bi-building me-1"></i> <%= processo.orgao || 'Órgão não informado' %>
                        </p>
                        <p class="card-text text-muted small mb-3">
                            <i class="bi bi-calendar-event me-1"></i> 
                            <%= processo.data_entrada ? new Date(processo.data_entrada).toLocaleDateString('pt-BR') : 'Data n/a' %>
                        </p>
                        <div class="p-2 bg-light rounded small text-secondary text-truncate mb-2">
                            <%= processo.situacao || 'Sem detalhes da situação...' %>
                        </div>
                    </div>
                    
                    <div class="card-footer bg-light border-top py-2 px-3">
                        <div class="row text-center gx-0">
                            <div class="col border-end">
                                <small class="d-block text-muted" style="font-size: 0.65rem; text-transform: uppercase;">Solic.</small>
                                <span class="fw-bold text-secondary"><%= processo.totais.solicitado %></span>
                            </div>
                            <div class="col border-end">
                                <small class="d-block text-muted" style="font-size: 0.65rem; text-transform: uppercase;">Aut.</small>
                                <span class="fw-bold text-dark"><%= processo.totais.autorizado %></span>
                            </div>
                            <div class="col border-end">
                                <small class="d-block text-muted" style="font-size: 0.65rem; text-transform: uppercase;">Entr.</small>
                                <span class="fw-bold text-success"><%= processo.totais.entregue %></span>
                            </div>
                            <div class="col">
                                <small class="d-block text-muted" style="font-size: 0.65rem; text-transform: uppercase;">Pend.</small>
                                <span class="fw-bold text-danger"><%= processo.totais.faltante %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<style>
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
    .transition-all { transition: all 0.3s ease; }
</style>

<script>
    let timeout = null;
    const input = document.getElementById('buscaInput');
    const grid = document.getElementById('processosGrid');

    if (input) {
        input.addEventListener('input', function(e) {
            const termo = e.target.value;

            clearTimeout(timeout);
            timeout = setTimeout(async () => {
                try {
                    const novaUrl = `/processos?busca=${encodeURIComponent(termo)}`;
                    window.history.replaceState(null, '', novaUrl);

                    grid.style.opacity = '0.5';
                    
                    const response = await fetch(novaUrl);
                    const textoHtml = await response.text();
                    
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(textoHtml, 'text/html');
                    
                    const novoGrid = doc.getElementById('processosGrid');
                    if (novoGrid) {
                        grid.innerHTML = novoGrid.innerHTML;
                    }
                } catch (error) {
                    console.error('Erro na pesquisa:', error);
                } finally {
                    grid.style.opacity = '1';
                }
            }, 500);
        });
    }
</script>