<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Processos</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/processos/create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Processo
        </a>
    </div>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body py-3">
        <form action="/processos" method="GET" class="row g-2 align-items-center">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" name="busca" 
                           placeholder="Pesquisar por Número do Processo ou Órgão..." 
                           value="<%= typeof busca !== 'undefined' ? busca : '' %>">
                </div>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle shadow-sm bg-white rounded">
        <thead class="table-light">
            <tr>
                <th>Nº Processo</th>
                <th>Data Entrada</th>
                <th>Órgão</th>
                <th>Status</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if (processos.length === 0) { %>
                <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        <% if (typeof busca !== 'undefined' && busca) { %>
                            Nenhum processo encontrado para "<strong><%= busca %></strong>".
                            <br><a href="/processos" class="btn btn-link">Limpar pesquisa</a>
                        <% } else { %>
                            Nenhum processo cadastrado ainda.
                        <% } %>
                    </td>
                </tr>
            <% } else { %>
                <% processos.forEach(function(p) { 
                    let badgeClass = 'bg-secondary';
                    if (p.status === 'DEMANDA CONCLUÍDA') badgeClass = 'status-concluido';
                    else if (p.status === 'PARCIAMENTE ENTREGUE') badgeClass = 'status-parcial';
                    else if (p.status === 'ENTREGA NÃO INICIADA') badgeClass = 'status-nao-iniciado';
                %>
                <tr>
                    <td>
                        <a href="/processos/<%= p.id %>" class="fw-bold text-decoration-none text-dark">
                            <%= p.numero_processo %>
                        </a>
                    </td>
                    <td><%= p.data_entrada ? new Date(p.data_entrada).toLocaleDateString('pt-BR') : '-' %></td>
                    <td><%= p.orgao %></td>
                    <td><span class="badge <%= badgeClass %> rounded-pill"><%= p.status %></span></td>
                    <td class="text-end">
                        <a href="/processos/<%= p.id %>" class="btn btn-sm btn-outline-primary" title="Ver Detalhes">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="/processos/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                    </td>
                </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>