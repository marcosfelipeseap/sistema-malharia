<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <div>
        <h1 class="h2">Processo: <%= processo.numero_processo %></h1>
        <span class="text-muted"><%= processo.orgao %></span>
    </div>
    <div>
        <a href="/processos/<%= processo.id %>/edit" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a href="/processos" class="btn btn-secondary">Voltar</a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title text-secondary mb-3"><i class="bi bi-info-circle"></i> Detalhes</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Data Entrada:</dt>
                    <dd class="col-sm-8"><%= processo.data_entrada ? new Date(processo.data_entrada).toLocaleDateString('pt-BR') : '-' %></dd>

                    <dt class="col-sm-4">Tipo Demanda:</dt>
                    <dd class="col-sm-8"><%= processo.tipo_demanda %></dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary"><%= processo.status %></span></dd>

                    <dt class="col-sm-4">Situação:</dt>
                    <dd class="col-sm-8"><%= processo.situacao || '-' %></dd>

                    <dt class="col-sm-4">Observações:</dt>
                    <dd class="col-sm-8"><%= processo.observacao || '-' %></dd>
                </dl>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-3">
                <h5 class="card-title text-secondary mb-0"><i class="bi bi-file-earmark-pdf"></i> Termos de Entrega</h5>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush mb-3">
                    <% if (!processo.termos || processo.termos.length === 0) { %>
                        <li class="list-group-item text-muted small fst-italic ps-0">Nenhum termo anexado.</li>
                    <% } else { %>
                        <% processo.termos.forEach(termo => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div class="text-truncate me-2">
                                    <span class="fw-bold d-block text-dark"><i class="bi bi-file-pdf text-danger"></i> <%= termo.numero_termo %></span>
                                    <small class="text-muted"><%= termo.nome_arquivo %></small>
                                </div>
                                <div class="d-flex gap-1">
                                    <a href="<%= termo.url_publica %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Visualizar">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form action="/processos/<%= processo.id %>/termos/<%= termo.id %>/delete" method="POST" onsubmit="return confirm('Remover este termo?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        <% }) %>
                    <% } %>
                </ul>
                <hr>
                <form action="/processos/<%= processo.id %>/termos" method="POST" enctype="multipart/form-data">
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Anexar Novo Termo</label>
                        <input type="text" class="form-control form-control-sm mb-2" name="numero_termo" placeholder="Numeração (Ex: Termo 01)" required>
                        <input type="file" class="form-control form-control-sm" name="arquivo_pdf" accept="application/pdf" required>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm w-100">
                        <i class="bi bi-cloud-upload"></i> Anexar PDF
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<h4 class="mb-3">Produtos do Processo</h4>
<div class="table-responsive mb-5">
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Item</th>
                <th>Descrição</th>
                <th class="text-center" style="width: 80px;">Tam.</th> 
                <th class="text-center">Solicitada</th>
                <th class="text-center">Autorizada</th>
                <th class="text-center">Entregue</th>
                <th class="text-center">Faltante</th>
                <th class="text-center">Prazo</th>
            </tr>
        </thead>
        <tbody>
            <% if (processo.itens.length === 0) { %>
                <tr><td colspan="8" class="text-center">Nenhum item registrado.</td></tr>
            <% } else { %>
                <% processo.itens.forEach(item => { %>
                    <tr>
                        <td><%= item.item ? item.item.nome : 'Item removido' %></td>
                        <td><%= item.descricao || '-' %></td>
                        <td class="text-center"><%= item.tamanho || '-' %></td> 
                        <td class="text-center"><%= item.qtd_solicitada %></td>
                        <td class="text-center"><%= item.qtd_autorizada %></td>
                        <td class="text-center"><%= item.qtd_entregue %></td>
                        <td class="text-center fw-bold text-danger"><%= item.qtd_faltante %></td>
                        <td class="text-center"><%= item.data_prazo ? new Date(item.data_prazo).toLocaleDateString('pt-BR') : '-' %></td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>

<div class="mt-4 text-end">
    <form action="/processos/<%= processo.id %>/delete" method="POST" onsubmit="return confirm('ATENÇÃO: Isso apagará o processo, os termos anexados e todos os registros de itens associados a ele. Continuar?');">
        <button type="submit" class="btn btn-outline-danger btn-sm">Excluir Processo Permanentemente</button>
    </form>
</div>